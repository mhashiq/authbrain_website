---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About — AuthBrain | Mission, Vision & Engineering Leadership"
  description="AuthBrain builds rigorous AI for healthcare and enterprise security. Meet the team, understand the mission, and learn why we exist."
>
  <Header />
  <main class="bg-[#FAFAFA] text-gray-900 overflow-x-hidden">

    <!-- HERO -->
    <section class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10 border-b border-gray-200 bg-white">
      <div class="relative max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-blue-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-700 mb-4">
          About AuthBrain
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl leading-tight mb-4">
          AI built for high-stakes enterprise problems.
        </h1>
        <p class="text-base sm:text-lg leading-relaxed text-gray-600">
          AuthBrain is an applied AI engineering company. We work on clinical intelligence and enterprise security — two domains where accuracy, speed, and trust carry real consequences.
        </p>
      </div>
    </section>

    <!-- MISSION & VISION -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">

        <!-- Mission -->
        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-2">Mission</span>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">
            Ship AI that earns clinical and enterprise trust.
          </h2>
          <p class="text-sm leading-relaxed text-gray-600 mb-4">
            Every system we build starts from a validated methodology. We do not cut corners on evaluation, benchmarking, or explainability. If a model cannot be justified to a clinician or a CISO, it does not ship.
          </p>
          <ul class="space-y-2">
            {['Research-grounded, not demo-ware', 'Every claim is measurable', 'Clinical and security-grade by default'].map((pt) => (
              <li class="flex items-center gap-2 text-xs font-medium text-gray-700">
                <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>
                {pt}
              </li>
            ))}
          </ul>
        </div>

        <!-- Vision -->
        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-2">Vision</span>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">
            A world where AI is infrastructure, not a feature.
          </h2>
          <p class="text-sm leading-relaxed text-gray-600 mb-4">
            We believe the next decade of healthcare and security will be defined by AI systems that operate quietly, reliably, and at scale — as foundational infrastructure embedded in clinical and enterprise workflows.
          </p>
          <ul class="space-y-2">
            {['AI as infrastructure, not a product add-on', 'Accessible to healthcare systems globally', 'Security that adapts faster than threats'].map((pt) => (
              <li class="flex items-center gap-2 text-xs font-medium text-gray-700">
                <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>
                {pt}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    <!-- OPERATING PRINCIPLES -->
    <section class="border-t border-gray-200 bg-white py-8">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-8">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-1 block">How We Work</span>
          <h2 class="text-3xl font-bold text-gray-900">Operating Principles</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {[
            {
              label: 'Research-first',
              body: 'Every method is validated before it enters production. We do not ship intuition.',
            },
            {
              label: 'Measurable impact',
              body: 'We define success with numbers — Dice coefficients, risk scores, false-positive rates.',
            },
            {
              label: 'Responsible by design',
              body: 'Explainability, auditability, and privacy are requirements — not afterthoughts.',
            },
            {
              label: 'Systems thinking',
              body: 'We build components that compose cleanly — authentication and diagnostics share the same engineering culture.',
            },
          ].map((v) => (
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
              <h3 class="text-base font-bold text-gray-900 mb-2">{v.label}</h3>
              <p class="text-xs text-gray-600 leading-relaxed">{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FOUNDER & ORIGIN -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 border-t border-gray-200">
      <div class="rounded-3xl border border-gray-200 bg-white p-8 md:p-10 shadow-xs">
        <div class="grid gap-8 lg:grid-cols-[auto_1fr] items-start">
          <div class="flex flex-col items-center lg:items-start gap-4">
            <img
              src="/founder-profile.png"
              alt="Md. Mehedi Hassan — Founder of AuthBrain"
              class="w-36 h-36 lg:w-44 lg:h-44 rounded-2xl object-cover border border-gray-200 shadow-sm"
              loading="lazy"
            />
            <div class="text-xs space-y-1 font-mono text-gray-600 text-center lg:text-left">
              <p><a href="https://scholar.google.com/citations?user=Ts2F72QAAAAJ" target="_blank" class="hover:text-blue-600">Google Scholar Profile &rarr;</a></p>
              <p><a href="https://www.linkedin.com/in/mh-ashiq/" target="_blank" class="hover:text-blue-600">LinkedIn Profile &rarr;</a></p>
            </div>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h2 class="text-2xl font-bold text-gray-900">Md. Mehedi Hassan</h2>
              <span class="rounded-full bg-blue-100 px-3 py-0.5 text-xs font-semibold text-blue-700">IEEE Member</span>
            </div>
            <p class="text-xs font-mono text-gray-500 mb-4">
              Ph.D. Candidate — Biomedical AI & Medical Imaging · Texas Tech University
            </p>
            <p class="text-sm leading-relaxed text-gray-600 mb-6">
              Md. Mehedi Hassan is a researcher and engineer working on AI-driven medical imaging and enterprise security systems. He has authored over 100 peer-reviewed publications and founded AuthBrain to bridge research innovation with production enterprise software.
            </p>

            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              {[
                { v: '100+', l: 'Publications' },
                { v: '2,200+', l: 'Citations' },
                { v: 'h-25', l: 'h-Index' },
                { v: '8', l: 'Books Edited' },
              ].map((s) => (
                <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-center">
                  <p class="text-lg font-bold text-blue-600">{s.v}</p>
                  <p class="text-[10px] font-semibold text-gray-500 uppercase">{s.l}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-gray-200 bg-white py-8 text-center">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">
        <h2 class="text-3xl font-bold text-gray-900">Ready to work together?</h2>
        <p class="text-base text-gray-600 max-w-md mx-auto">
          Partner with our engineering team to deploy clinical AI and zero-trust authentication.
        </p>
        <div class="flex justify-center gap-4 pt-2">
          <a href={`${import.meta.env.BASE_URL}contact/`} class="rounded-xl bg-blue-600 px-7 py-3.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 transition">
            Get in Touch
          </a>
          <a href={`${import.meta.env.BASE_URL}services/`} class="rounded-xl border border-gray-300 bg-white px-7 py-3.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">
            View Services
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
