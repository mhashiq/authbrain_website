---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="AuthBrain | Agent Lab" description="Enterprise agentic workflows, intake, planning, execution, and verification engines.">
  <Header />
  <main class="bg-[#FAFAF8] text-[#3A3A3A] mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <section class="max-w-3xl space-y-4">
      <span class="inline-flex rounded-full bg-[#FDF2F0] border border-[#F8D5CE] px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-[#E64A25]">
        Agent Lab
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-[#0D0D0D] sm:text-5xl">
        Agentic Execution Architecture
      </h1>
      <p class="text-base sm:text-lg text-[#3A3A3A] leading-relaxed">
        Structured AI agent pipelines: intake, planning, execution, and real-time validation for enterprise operations.
      </p>
    </section>

    <section class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <article class="rounded-2xl border border-[#E5E3E0] bg-white p-6 shadow-xs">
        <p class="text-xs font-mono font-bold text-[#E64A25] uppercase">Step 01</p>
        <h2 class="mt-2 text-xl font-bold text-[#0D0D0D]">Intake</h2>
        <p class="mt-2 text-sm text-[#3A3A3A] leading-relaxed">Capture task payloads, identity constraints, and desired enterprise output.</p>
      </article>
      <article class="rounded-2xl border border-[#E5E3E0] bg-white p-6 shadow-xs">
        <p class="text-xs font-mono font-bold text-[#E64A25] uppercase">Step 02</p>
        <h2 class="mt-2 text-xl font-bold text-[#0D0D0D]">Plan</h2>
        <p class="mt-2 text-sm text-[#3A3A3A] leading-relaxed">Decompose tasks into authenticated execution graphs.</p>
      </article>
      <article class="rounded-2xl border border-[#E5E3E0] bg-white p-6 shadow-xs">
        <p class="text-xs font-mono font-bold text-[#E64A25] uppercase">Step 03</p>
        <h2 class="mt-2 text-xl font-bold text-[#0D0D0D]">Execute</h2>
        <p class="mt-2 text-sm text-[#3A3A3A] leading-relaxed">Run inference models, transform medical data, or trigger zero-trust access controls.</p>
      </article>
      <article class="rounded-2xl border border-[#E5E3E0] bg-white p-6 shadow-xs">
        <p class="text-xs font-mono font-bold text-[#E64A25] uppercase">Step 04</p>
        <h2 class="mt-2 text-xl font-bold text-[#0D0D0D]">Verify</h2>
        <p class="mt-2 text-sm text-[#3A3A3A] leading-relaxed">Validate output schema and security constraints before finalizing state.</p>
      </article>
    </section>
  </main>
  <Footer />
</BaseLayout>