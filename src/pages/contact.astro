---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="AuthBrain | Contact & Technical Consultation" description="Schedule a technical demo or get in touch with AuthBrain's engineering team.">
  <Header />
  <main class="bg-[#FAFAFA] text-gray-900">
    <!-- 1. Hero Section -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12 text-center border-b border-gray-200 bg-white">
      <div class="max-w-4xl mx-auto space-y-6">
        <span class="inline-flex rounded-full bg-blue-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-700">
          Get in Touch
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
          Schedule Technical Demo & Consultation
        </h1>
        <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Partner with AuthBrain's engineering team to deploy enterprise zero-trust authentication and clinical AI engines directly into your production infrastructure.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4 pt-2">
          <a href="#booking" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-7 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-blue-700 transition">
            Schedule a Demo
          </a>
          <a href="#contact-form" class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-7 py-3.5 text-base font-semibold text-gray-700 hover:bg-gray-50 transition">
            Send an Inquiry
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Contact Info Cards -->
    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-xs">
          <div class="text-2xl mb-2">📧</div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">Email Support</h3>
          <a href="mailto:authbrain.tech@gmail.com" class="text-sm font-medium text-blue-600 hover:underline">authbrain.tech@gmail.com</a>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-xs">
          <div class="text-2xl mb-2">📱</div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">Direct Line</h3>
          <p class="text-sm text-gray-600 font-medium">+61 0480 569 667</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-xs">
          <div class="text-2xl mb-2">⏰</div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">Response Time</h3>
          <p class="text-sm text-gray-600">Sub-24h Technical Turnaround</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-xs">
          <div class="text-2xl mb-2">🌍</div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">Deployment</h3>
          <p class="text-sm text-gray-600">Global On-Prem / Cloud</p>
        </div>
      </div>
    </section>

    <!-- 3. Booking & Form -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 border-t border-gray-200">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        
        <!-- Left: Booking -->
        <div id="booking" class="space-y-6">
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Book a Demo Meeting</h2>
            <p class="text-sm text-gray-600 leading-relaxed">Select a time that works for your engineering or security leadership team to review platform capabilities and architecture.</p>
          </div>
          
          <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-8 shadow-xs">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2 block">30-Minute Discovery Session</span>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Technical Deep-Dive Call</h3>
            <ul class="space-y-2.5 text-sm text-gray-700 font-medium mb-6">
              <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> Zero-Trust Adaptive Auth Benchmarks</li>
              <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> Clinical EHR & 3D Imaging AI Models</li>
              <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> On-Premise & Private Cloud Deployment</li>
              <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> Auto Email Confirmation to authbrain.tech@gmail.com</li>
            </ul>
            <a href="https://calendar.app.google/MiSuR9f32BftrG4y5" target="_blank" rel="noopener noreferrer" class="flex w-full items-center justify-center rounded-xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 transition">
              Open Google Calendar Booking &rarr;
            </a>
          </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div id="contact-form" class="rounded-2xl border border-gray-200 bg-white p-8 shadow-xs">
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Send an Inquiry</h2>
            <p class="mt-1 text-sm text-gray-600">Fill out your details below and an email notification will be delivered immediately to <strong>authbrain.tech@gmail.com</strong>.</p>
          </div>

          <div id="form-success-banner" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 p-4 mb-5 text-emerald-800 text-sm font-medium">
            ✓ Your inquiry has been submitted! An email notification has been sent to <strong>authbrain.tech@gmail.com</strong> and our engineering team will respond within 24 hours.
          </div>

          <form id="inquiry-form" action="https://formsubmit.co/authbrain.tech@gmail.com" method="POST" class="space-y-5">
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_subject" value="New Technical Demo & Inquiry - AuthBrain" />
            <input type="hidden" name="_template" value="table" />

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-xs font-semibold uppercase text-gray-700 mb-1">Full Name *</label>
                <input type="text" name="name" id="name" required class="w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-blue-600 focus:bg-white focus:outline-none" placeholder="Dr. Alex Vance" />
              </div>
              <div>
                <label for="company" class="block text-xs font-semibold uppercase text-gray-700 mb-1">Company / Organization</label>
                <input type="text" name="company" id="company" class="w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-blue-600 focus:bg-white focus:outline-none" placeholder="Metro Health System" />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="email" class="block text-xs font-semibold uppercase text-gray-700 mb-1">Work Email *</label>
                <input type="email" name="email" id="email" required class="w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-blue-600 focus:bg-white focus:outline-none" placeholder="alex@metrohealth.org" />
              </div>
              <div>
                <label for="phone" class="block text-xs font-semibold uppercase text-gray-700 mb-1">Phone Number</label>
                <input type="tel" name="phone" id="phone" class="w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-blue-600 focus:bg-white focus:outline-none" placeholder="+1 (555) 000-0000" />
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase text-gray-700 mb-1">Requirements / Message *</label>
              <textarea name="message" id="message" rows="4" required class="w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-blue-600 focus:bg-white focus:outline-none" placeholder="Tell us about your technical goals and deployment timeline..."></textarea>
            </div>

            <button id="submit-btn" type="submit" class="w-full rounded-xl bg-blue-600 py-4 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 transition">
              Submit Inquiry
            </button>
          </form>
        </div>

      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  const form = document.getElementById('inquiry-form');
  const submitBtn = document.getElementById('submit-btn');
  const successBanner = document.getElementById('form-success-banner');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      const originalText = submitBtn.innerText;
      submitBtn.innerText = 'Submitting...';
      submitBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const res = await fetch('https://formsubmit.co/ajax/authbrain.tech@gmail.com', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });
        if (res.ok) {
          if (successBanner) successBanner.classList.remove('hidden');
          form.reset();
        } else {
          form.submit();
        }
      } catch (err) {
        form.submit();
      } finally {
        submitBtn.innerText = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>