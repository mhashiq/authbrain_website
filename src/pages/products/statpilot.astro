---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="StatPilot — Automated, Transparent Statistical Analysis & Decision Engine | AuthBrain"
  description="Automated statistical analysis engine evaluating distribution normality and variance homogeneity to pick optimal parametric or non-parametric tests with audit-ready reports."
>
  <Header />
  <main>

    <!-- Breadcrumb -->
    <nav class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-xs font-mono text-white/40">
        <li><a href={import.meta.env.BASE_URL} class="hover:text-white transition">Home</a></li>
        <li class="text-white/20">/</li>
        <li><a href={`${import.meta.env.BASE_URL}products/`} class="hover:text-white transition">Products</a></li>
        <li class="text-white/20">/</li>
        <li class="text-white/70">StatPilot</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:items-start">
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-indigo-400/20 bg-indigo-400/10 px-3 py-1 text-[11px] font-mono uppercase tracking-widest text-indigo-400">
              Data Science & Analytics
            </span>
            <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-[11px] font-mono uppercase tracking-wide text-emerald-400">
              ● Published v1.1.0
            </span>
          </div>

          <h1 class="text-4xl font-semibold tracking-[-0.04em] text-white sm:text-5xl mb-4">StatPilot 🧭</h1>
          <p class="text-base font-mono text-white/50 mb-6">Automated, Transparent Statistical Analysis for Researchers & Data Scientists</p>
          <p class="text-base leading-7 text-white/[0.72] max-w-2xl mb-8">
            StatPilot simplifies complex statistical workflows by automating group comparison selection and assumption testing. Instead of manually checking assumptions across multiple software tools, StatPilot evaluates your dataset's distribution, runs Shapiro-Wilk normality and Levene's variance homogeneity diagnostics, picks the correct parametric or non-parametric test, calculates effect sizes, and outputs transparent, publication-ready Markdown reports.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-4">
            <a
              href="https://pypi.org/project/statpilot/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L1.75 6v12L12 24l10.25-6V6L12 0zm-1.25 3.5h2.5v3.5h-2.5V3.5zM4.5 7.5h3.5v2.5H4.5V7.5zm11.5 0h3.5v2.5H16V7.5zm-8 4h8v2.5h-8V11.5zm-3.5 4h3.5v2.5H4.5V15.5zm11.5 0h3.5v2.5H16V15.5z"/></svg>
              PyPI Package (Live)
            </a>
            <a
              href="https://github.com/mhashiq/statpilot"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-medium text-black transition hover:bg-white/90 focus:outline-none focus:ring-2 focus:ring-white"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              View on GitHub
            </a>
            <a href={`${import.meta.env.BASE_URL}products/`} class="inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/5 px-6 py-3 text-sm font-medium text-white/80 transition hover:bg-white/10">
              ← Back to Products
            </a>
          </div>
        </div>

        <!-- Tech Stack Sidebar -->
        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6 min-w-[220px]">
          <p class="text-xs font-mono uppercase tracking-widest text-white/40 mb-4">Tech Stack</p>
          <div class="flex flex-col gap-2">
            {['Python (3.9+)', 'Pandas', 'SciPy', 'Rich CLI', 'Seaborn', 'PyTest', 'Jinja2'].map((t) => (
              <span class="rounded-lg border border-white/[0.08] bg-white/[0.03] px-3 py-2 text-xs font-mono text-white/70">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Key Highlights -->
    <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-semibold tracking-[-0.04em] text-white mb-8">Key Engineering Highlights</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { title: 'Automated Statistical Decision Engine', body: 'Evaluates group count, sample pairing, normality (Shapiro-Wilk), and equal variance (Levene’s test) to automatically select the optimal statistical test.' },
          { title: 'Transparent Audit Diagnostics', body: 'Documents step-by-step reasoning for test selection, removing black-box ambiguity for manuscript reviewers and auditors.' },
          { title: 'Automated Effect Size Metric Computation', body: 'Calculates standardized effect sizes — Cohen’s d, Rank-Biserial r, Eta-squared (η²), and Epsilon-squared (ϵ²) — alongside p-values and confidence intervals.' },
          { title: 'Publication-Ready Markdown Reports', body: 'Generates formatted statistical write-ups directly exportable into academic papers and clinical trial submissions.' },
          { title: 'Rich Terminal Visuals & Seaborn Graphics', body: 'Outputs formatted terminal summary tables via Rich and publication-quality distribution box plots using Seaborn.' },
          { title: 'Seamless Python API & CLI Tooling', body: 'Designed for effortless integration into Python scripts, Jupyter notebooks, or directly executed from terminal shell scripts.' },
        ].map((h) => (
          <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
            <h3 class="text-sm font-semibold text-white mb-2">{h.title}</h3>
            <p class="text-xs leading-5 text-white/60">{h.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Decision Matrix Table -->
    <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8">
        <h2 class="text-xl font-semibold tracking-[-0.04em] text-white mb-2">Automated Statistical Decision Tree</h2>
        <p class="text-xs text-white/50 mb-6 font-mono">StatPilot automates assumption testing and selects tests according to standard statistical decision matrices:</p>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono border-collapse">
            <thead>
              <tr class="border-b border-white/10 text-white/40 uppercase tracking-wider">
                <th class="py-3 px-4">Groups</th>
                <th class="py-3 px-4">Paired / Repeated</th>
                <th class="py-3 px-4">Normality (Shapiro-Wilk)</th>
                <th class="py-3 px-4">Equal Variance (Levene)</th>
                <th class="py-3 px-4 text-emerald-400">Test Selected</th>
                <th class="py-3 px-4 text-indigo-400">Effect Size Metric</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06] text-white/80">
              <tr>
                <td class="py-3 px-4">2 Groups</td>
                <td class="py-3 px-4">No</td>
                <td class="py-3 px-4 text-emerald-400">Normal (α = 0.05)</td>
                <td class="py-3 px-4 text-emerald-400">Equal (α = 0.05)</td>
                <td class="py-3 px-4 font-semibold text-white">Independent Samples t-test</td>
                <td class="py-3 px-4 text-indigo-300">Cohen's d</td>
              </tr>
              <tr>
                <td class="py-3 px-4">2 Groups</td>
                <td class="py-3 px-4">No</td>
                <td class="py-3 px-4 text-emerald-400">Normal (α = 0.05)</td>
                <td class="py-3 px-4 text-amber-400">Unequal (α &lt; 0.05)</td>
                <td class="py-3 px-4 font-semibold text-white">Welch's t-test</td>
                <td class="py-3 px-4 text-indigo-300">Cohen's d</td>
              </tr>
              <tr>
                <td class="py-3 px-4">2 Groups</td>
                <td class="py-3 px-4">No</td>
                <td class="py-3 px-4 text-amber-400">Non-Normal (α &lt; 0.05)</td>
                <td class="py-3 px-4 text-white/30">N/A</td>
                <td class="py-3 px-4 font-semibold text-white">Mann-Whitney U</td>
                <td class="py-3 px-4 text-indigo-300">Rank-Biserial r</td>
              </tr>
              <tr>
                <td class="py-3 px-4">2 Groups</td>
                <td class="py-3 px-4 text-cyan-400">Yes</td>
                <td class="py-3 px-4 text-emerald-400">Normal (α = 0.05)</td>
                <td class="py-3 px-4 text-white/30">N/A</td>
                <td class="py-3 px-4 font-semibold text-white">Paired Samples t-test</td>
                <td class="py-3 px-4 text-indigo-300">Cohen's d</td>
              </tr>
              <tr>
                <td class="py-3 px-4">2 Groups</td>
                <td class="py-3 px-4 text-cyan-400">Yes</td>
                <td class="py-3 px-4 text-amber-400">Non-Normal (α &lt; 0.05)</td>
                <td class="py-3 px-4 text-white/30">N/A</td>
                <td class="py-3 px-4 font-semibold text-white">Wilcoxon Signed-Rank</td>
                <td class="py-3 px-4 text-indigo-300">Rank-Biserial r</td>
              </tr>
              <tr>
                <td class="py-3 px-4">3+ Groups</td>
                <td class="py-3 px-4">No</td>
                <td class="py-3 px-4 text-emerald-400">Normal (α = 0.05)</td>
                <td class="py-3 px-4 text-emerald-400">Equal (α = 0.05)</td>
                <td class="py-3 px-4 font-semibold text-white">One-Way ANOVA</td>
                <td class="py-3 px-4 text-indigo-300">Eta-squared (η²)</td>
              </tr>
              <tr>
                <td class="py-3 px-4">3+ Groups</td>
                <td class="py-3 px-4">No</td>
                <td class="py-3 px-4 text-amber-400">Non-Normal / Heterogeneous</td>
                <td class="py-3 px-4 text-white/30">N/A</td>
                <td class="py-3 px-4 font-semibold text-white">Kruskal-Wallis H</td>
                <td class="py-3 px-4 text-indigo-300">Epsilon-squared (ϵ²)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Execution Telemetry Panel -->
    <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-white/10 bg-black/60 p-6 backdrop-blur-xl">
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-5">
          <span class="font-mono text-xs font-semibold tracking-wider text-white/60">STATPILOT // AUTOMATED ANALYSIS TRACE</span>
          <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 font-mono text-[11px] font-medium text-emerald-400 border border-emerald-500/20">PYPI v1.1.0</span>
        </div>
        <div class="space-y-3 font-mono text-xs">
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4">
            <div class="flex items-center justify-between text-white/40 text-[11px] mb-1.5">
              <span>DATA_LOAD // DATAFRAME_CHECK</span><span>0ms</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="font-sans text-sm font-medium text-white">Dataset: research_data.csv (N=342 samples)</span>
              <span class="rounded bg-indigo-500/10 px-2 py-0.5 text-[10px] text-indigo-400 border border-indigo-500/20">PASSED [1ms]</span>
            </div>
            <p class="mt-1 font-sans text-xs text-white/50">Target: response_time · Group: treatment_group (Control vs Treatment)</p>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4">
            <div class="flex items-center justify-between text-white/40 text-[11px] mb-1.5">
              <span>ASSUMPTION_DIAGNOSTICS // SHAPIRO_LEVENE</span><span>3ms</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="font-sans text-sm font-medium text-white">Shapiro-Wilk W=0.988 (p=0.241) · Levene statistic=1.12 (p=0.291)</span>
              <span class="rounded bg-emerald-500/10 px-2 py-0.5 text-[10px] text-emerald-400 border border-emerald-500/20">NORMAL & EQUAL VAR</span>
            </div>
            <p class="mt-1 font-sans text-xs text-white/50">Normality confirmed (p &gt; 0.05) · Homogeneity of variance confirmed (p &gt; 0.05)</p>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4">
            <div class="flex items-center justify-between text-white/40 text-[11px] mb-1.5">
              <span>TEST_EXECUTION // INDEPENDENT_TTEST</span><span>5ms</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="font-sans text-sm font-medium text-white">Independent Samples t-test: t=4.82, p=2.1e-06, Cohen's d=0.52</span>
              <span class="rounded bg-cyan-500/10 px-2 py-0.5 text-[10px] text-cyan-400 border border-cyan-500/20">REPORT GENERATED</span>
            </div>
            <p class="mt-1 font-sans text-xs text-white/50">Statistically significant difference detected · Markdown report exported to report.md</p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
