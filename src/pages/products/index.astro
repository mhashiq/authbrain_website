---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const products = [
  {
    id: 'authb2b',
    slug: 'authb2b',
    name: 'AuthB2B',
    category: 'Enterprise Security',
    catKey: 'security',
    status: 'Production',
    statusClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    tagline: 'Enterprise B2B AI-Driven Adaptive Authentication Platform',
    summary: 'High-concurrency B2B authentication engine integrating real-time AI security models with zero-trust access control.',
    tech: ['Python', 'PyTorch', 'FastAPI', 'OAuth2/OIDC', 'Docker', 'PostgreSQL'],
    links: [
      { label: 'View on GitHub', url: 'https://github.com/mhashiq/AuthB2B', type: 'github' }
    ],
    detailUrl: `${import.meta.env.BASE_URL}products/authb2b/`
  },
  {
    id: 'authfacegraph',
    slug: 'authfacegraph',
    name: 'AuthFaceGraph',
    category: 'Fraud Detection',
    catKey: 'security',
    status: 'Production',
    statusClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    tagline: 'Biometric Facial Recognition & Graph Neural Network Security',
    summary: 'Enterprise identity verification combining deep facial recognition with Graph Neural Networks to detect fraud rings in real time.',
    tech: ['PyTorch', 'DeepFace', 'GNN', 'OpenCV', 'Flask', 'Neo4j'],
    links: [
      { label: 'View on GitHub', url: 'https://github.com/mhashiq/AuthFaceGraph', type: 'github' }
    ],
    detailUrl: `${import.meta.env.BASE_URL}products/authfacegraph/`
  },
  {
    id: '3dsegmaunet',
    slug: '3dsegmaunet',
    name: '3DSegmaUNet',
    category: 'Medical AI',
    catKey: 'medical',
    status: 'Research',
    statusClass: 'bg-amber-50 text-amber-700 border-amber-200',
    tagline: 'AI-Powered 3D Medical Imaging & Volumetric Liver Segmentation',
    summary: 'End-to-end medical AI application for automated 3D volumetric liver segmentation from CT scans with high Dice similarity coefficients.',
    tech: ['Python', 'PyTorch', 'MONAI', 'SimpleITK', 'Flask', 'Docker', '3D Slicer'],
    links: [
      { label: 'Research Preview', url: '#', type: 'preview' }
    ],
    detailUrl: `${import.meta.env.BASE_URL}products/3dsegmaunet/`
  },
  {
    id: 'multiclipboard',
    slug: 'multiclipboard',
    name: 'MultiClipboard',
    category: 'Developer Tools',
    catKey: 'devtools',
    status: 'Published',
    statusClass: 'bg-blue-50 text-blue-700 border-blue-200',
    tagline: 'Modern Chrome Extension for Smart Multi-Item Clipboard Management',
    summary: 'Manifest V3 Chrome Extension for multi-item clipboard history, smart snippet categorization, and rich-text/plain-text formatting.',
    tech: ['JavaScript (ES6+)', 'Manifest V3', 'Web Extension API', 'HTML5/CSS3', 'Chrome Storage API'],
    links: [
      { label: 'Chrome Web Store', url: 'https://chromewebstore.google.com/detail/naigcmklidmmeinjpllcnbodpbdndbof', type: 'chrome' },
      { label: 'View on GitHub', url: 'https://github.com/mhashiq/MultiClipboard', type: 'github' }
    ],
    detailUrl: `${import.meta.env.BASE_URL}products/multiclipboard/`
  },
  {
    id: 'extensiontrustauditor',
    slug: 'extensiontrustauditor',
    name: 'Extension Trust Auditor',
    category: 'Security & Privacy',
    catKey: 'security',
    status: 'Published',
    statusClass: 'bg-blue-50 text-blue-700 border-blue-200',
    tagline: 'Lightweight, Privacy-First Permission & Update Watchdog Chrome Extension',
    summary: 'Monitors installed Chrome extensions for permission expansions, ownership/version jumps, and security risks — translating complex Chrome permissions into clear, human language.',
    tech: ['JavaScript (ES6+)', 'Manifest V3', 'Web Extension API', 'Chrome Alarms API', 'HTML5/CSS3', 'Zero-Telemetry Storage'],
    links: [
      { label: 'View on GitHub', url: 'https://github.com/mhashiq/Trust_Auditor', type: 'github' }
    ],
    detailUrl: `${import.meta.env.BASE_URL}products/extensiontrustauditor/`
  },
  {
    id: 'statpilot',
    slug: 'statpilot',
    name: 'StatPilot',
    category: 'Data Science',
    catKey: 'datascience',
    status: 'Published',
    statusClass: 'bg-blue-50 text-blue-700 border-blue-200',
    tagline: 'Automated, Transparent Statistical Analysis & Decision Engine',
    summary: 'Automated statistical analysis engine evaluating distribution normality and variance homogeneity to pick optimal parametric or non-parametric tests with audit-ready reports.',
    tech: ['Python', 'Pandas', 'SciPy', 'Rich CLI', 'Seaborn', 'PyTest', 'CLI & API'],
    links: [
      { label: 'PyPI Package', url: 'https://pypi.org/project/statpilot/', type: 'pypi' },
      { label: 'View on GitHub', url: 'https://github.com/mhashiq/statpilot', type: 'github' }
    ],
    detailUrl: `${import.meta.env.BASE_URL}products/statpilot/`
  }
];
---

<BaseLayout 
  title="Enterprise AI Products | AuthBrain Security & Clinical Platforms" 
  description="Explore AuthBrain's production AI platforms: adaptive authentication, biometric fraud detection, medical imaging segmentation, extension trust auditing, and statistical analysis tools."
>
  <Header />
  <main class="bg-[#FAFAF8] text-[#3A3A3A]">

    <!-- Page Header -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12 border-b border-[#E5E3E0] bg-white">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-[#FDF2F0] border border-[#F8D5CE] px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-[#E64A25] mb-3">
          Flagship Software
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-[#0D0D0D] sm:text-5xl lg:text-6xl mb-4">
          Enterprise Systems & Platforms
        </h1>
        <p class="text-base sm:text-lg text-[#3A3A3A] leading-relaxed">
          Production-grade platforms engineered at the intersection of zero-trust security, clinical AI, developer infrastructure, and statistical science.
        </p>
      </div>

      <!-- Filter / Tab Bar -->
      <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-[#E5E3E0] pt-6">
        <button data-filter="all" class="filter-tab active rounded-xl border border-[#E64A25] bg-[#E64A25] px-4 py-2 text-xs font-semibold text-white shadow-xs transition">
          All Systems (6)
        </button>
        <button data-filter="security" class="filter-tab rounded-xl border border-[#E5E3E0] bg-white px-4 py-2 text-xs font-medium text-[#3A3A3A] hover:bg-[#F4F3F1] transition">
          Security & Fraud
        </button>
        <button data-filter="medical" class="filter-tab rounded-xl border border-[#E5E3E0] bg-white px-4 py-2 text-xs font-medium text-[#3A3A3A] hover:bg-[#F4F3F1] transition">
          Medical AI
        </button>
        <button data-filter="devtools" class="filter-tab rounded-xl border border-[#E5E3E0] bg-white px-4 py-2 text-xs font-medium text-[#3A3A3A] hover:bg-[#F4F3F1] transition">
          Developer Tools
        </button>
        <button data-filter="datascience" class="filter-tab rounded-xl border border-[#E5E3E0] bg-white px-4 py-2 text-xs font-medium text-[#3A3A3A] hover:bg-[#F4F3F1] transition">
          Data Science
        </button>
      </div>
    </section>

    <!-- Product Cards Grid -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2">
        {products.map((product) => (
          <div data-cat={product.catKey} class="product-card rounded-2xl border border-[#E5E3E0] bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-[#F8D5CE] hover:shadow-lg flex flex-col justify-between">
            <div>
              <!-- Top Row: Status Pill & Category Label + Icon -->
              <div class="flex items-center justify-between mb-4">
                <span class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-wider ${product.statusClass}`}>
                  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                  {product.status}
                </span>

                <div class="flex items-center gap-2 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                  <span>{product.category}</span>
                  {product.catKey === 'security' && (
                    <svg class="h-4 w-4 text-[#E64A25]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                  )}
                  {product.catKey === 'medical' && (
                    <svg class="h-4 w-4 text-[#E64A25]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  )}
                  {product.catKey === 'devtools' && (
                    <svg class="h-4 w-4 text-[#E64A25]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                  )}
                  {product.catKey === 'datascience' && (
                    <svg class="h-4 w-4 text-[#E64A25]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                  )}
                </div>
              </div>

              <!-- Title & Tagline -->
              <h2 class="text-2xl font-extrabold text-[#0D0D0D] mb-1">{product.name}</h2>
              <p class="text-sm font-semibold text-[#0D0D0D] mb-3">{product.tagline}</p>
              <p class="text-sm text-[#3A3A3A] leading-relaxed mb-5">{product.summary}</p>

              <!-- Stack Tags -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {product.tech.map((t) => (
                  <span class="rounded-lg bg-[#F4F3F1] border border-[#E5E3E0] px-2.5 py-1 text-xs font-mono font-medium text-[#0D0D0D]">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Footer Action Row -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-5 border-t border-[#E5E3E0]">
              <div class="flex flex-wrap items-center gap-2">
                {product.links.map((link) => (
                  link.type === 'preview' ? (
                    <span class="inline-flex items-center gap-1.5 rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2 text-xs font-semibold text-amber-800">
                      Research Preview
                    </span>
                  ) : (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-xl border border-[#E5E3E0] bg-white px-3.5 py-2 text-xs font-semibold text-[#3A3A3A] hover:bg-[#F4F3F1] transition"
                    >
                      {link.type === 'github' && (
                        <svg class="h-4 w-4 text-[#0D0D0D]" fill="currentColor" viewBox="0 0 24 24">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                        </svg>
                      )}
                      {link.type === 'chrome' && (
                        <svg class="h-4 w-4 text-[#E64A25]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                        </svg>
                      )}
                      {link.type === 'pypi' && (
                        <svg class="h-4 w-4 text-[#E64A25]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                      )}
                      <span>{link.label}</span>
                    </a>
                  )
                ))}
              </div>

              <!-- Main Conversion CTA Button -->
              <a
                href={product.detailUrl}
                class="inline-flex items-center gap-1.5 rounded-xl bg-[#E64A25] px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-[#C93E1D] transition"
              >
                <span>View Product Details</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Trust & Conversion Section -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 border-t border-[#E5E3E0]">
      <!-- Short Stat Row -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 text-center mb-10 border border-[#E5E3E0] bg-white p-6 rounded-2xl shadow-xs">
        <div>
          <p class="text-2xl font-extrabold text-[#E64A25]">6 Production-Grade Platforms</p>
          <p class="text-xs font-medium text-gray-500 mt-0.5">Enterprise Security & Clinical AI</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-[#E64A25]">6+ Years Combined Deployment</p>
          <p class="text-xs font-medium text-gray-500 mt-0.5">Real Production Benchmarks</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-[#E64A25]">Open Source + Enterprise Licensing</p>
          <p class="text-xs font-medium text-gray-500 mt-0.5">Custom On-Prem Deployment</p>
        </div>
      </div>

      <!-- Closing CTA Band -->
      <div class="rounded-3xl border border-[#F8D5CE] bg-[#FDF2F0]/80 p-8 sm:p-10 text-center shadow-xs">
        <h2 class="text-2xl font-extrabold text-[#0D0D0D] sm:text-3xl mb-2">
          Need a platform tailored to your infrastructure?
        </h2>
        <p class="text-sm sm:text-base text-[#3A3A3A] max-w-2xl mx-auto mb-6">
          Every product above can be customized, white-labeled, or deployed on-premise for enterprise clients.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}contact/`}
          class="inline-flex items-center justify-center rounded-xl bg-[#E64A25] px-7 py-3.5 text-sm font-semibold text-white shadow-xs hover:bg-[#C93E1D] transition"
        >
          Schedule Technical Demo
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.product-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('bg-[#E64A25]', 'text-white', 'border-[#E64A25]', 'shadow-xs');
        t.classList.add('bg-white', 'text-[#3A3A3A]', 'border-[#E5E3E0]');
      });
      tab.classList.remove('bg-white', 'text-[#3A3A3A]', 'border-[#E5E3E0]');
      tab.classList.add('bg-[#E64A25]', 'text-white', 'border-[#E64A25]', 'shadow-xs');

      const filter = tab.dataset.filter;

      cards.forEach((card) => {
        if (filter === 'all' || card.dataset.cat === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
