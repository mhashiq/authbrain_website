---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const products = [
  {
    id: 'authb2b',
    slug: 'authb2b',
    name: 'AuthB2B',
    tagline: 'Enterprise B2B AI-Driven Adaptive Authentication Platform',
    category: 'Enterprise Security',
    categoryColor: 'text-cyan-400',
    categoryBg: 'bg-cyan-400/10 border-cyan-400/20',
    status: 'Production',
    github: 'https://github.com/mhashiq/AuthB2B',
    icon: `<svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
    summary: 'High-concurrency B2B authentication engine integrating real-time AI security models with zero-trust access control.',
    tech: ['Python', 'PyTorch', 'FastAPI', 'OAuth2/OIDC', 'Docker', 'PostgreSQL'],
    description: 'Architected a high-concurrency B2B authentication engine integrating real-time AI security models. Implemented unsupervised machine learning for risk-based authentication, detecting login anomalies and contextual user behavior deviations to enforce zero-trust access control. Built with dynamic RBAC/ABAC policy enforcement and scalable microservices.',
    highlights: [
      'Unsupervised ML risk scoring on every login event',
      'Real-time session anomaly & behavioral deviation detection',
      'RBAC/ABAC dynamic policy enforcement engine',
      'OAuth2/OIDC-compliant token issuance and validation',
      'Microservices-based horizontal scaling architecture',
      'Sub-50ms access decision latency at production load',
    ],
  },
  {
    id: 'authfacegraph',
    slug: 'authfacegraph',
    name: 'AuthFaceGraph',
    tagline: 'Biometric Facial Recognition & Graph Neural Network Security',
    category: 'Fraud Detection',
    categoryColor: 'text-purple-400',
    categoryBg: 'bg-purple-400/10 border-purple-400/20',
    status: 'Production',
    github: 'https://github.com/mhashiq/AuthFaceGraph',
    icon: `<svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>`,
    summary: 'Enterprise identity verification combining deep facial recognition with Graph Neural Networks to detect fraud rings in real time.',
    tech: ['PyTorch', 'DeepFace', 'GNN', 'OpenCV', 'Flask', 'Neo4j'],
    description: 'Engineered an enterprise identity verification framework combining deep facial recognition with Graph Neural Networks (GNNs). Utilized CNN feature extraction to compute high-dimensional facial embeddings and built dynamic graph representations to detect fraud rings, identity spoofing, and unauthorized access attempts in real time.',
    highlights: [
      'CNN-based high-dimensional facial embedding extraction',
      'Dynamic graph construction for identity relationship mapping',
      'Real-time fraud ring and spoofing detection',
      'Neo4j graph database for identity relationship persistence',
      'Multi-modal biometric scoring with confidence thresholds',
      'Live unauthorized access attempt mitigation pipeline',
    ],
  },
  {
    id: '3dsegmaunet',
    slug: '3dsegmaunet',
    name: '3DSegmaUNet',
    tagline: 'AI-Powered 3D Medical Imaging & Volumetric Liver Segmentation',
    category: 'Medical AI',
    categoryColor: 'text-emerald-400',
    categoryBg: 'bg-emerald-400/10 border-emerald-400/20',
    status: 'Research',
    github: '#',
    icon: `<svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>`,
    summary: 'End-to-end medical AI application for automated 3D volumetric liver segmentation from CT scans with high Dice similarity coefficients.',
    tech: ['Python', 'PyTorch', 'MONAI', 'SimpleITK', 'Flask', 'Docker', '3D Slicer'],
    description: 'Designed and deployed an end-to-end medical AI application for automated 3D volumetric liver segmentation from CT scans. Implemented a lightweight 3D U-Net deep learning architecture optimized for high Dice similarity coefficients and low inference latency, packaged into a web workflow for radiologists and clinical researchers.',
    highlights: [
      'Lightweight 3D U-Net architecture with optimized inference',
      'High Dice Similarity Coefficient (DSC) segmentation accuracy',
      'Automated CT scan volumetric liver boundary extraction',
      'MONAI medical imaging framework integration',
      'Docker-containerized web workflow for clinical environments',
      'Radiologist-facing review interface with 3D Slicer export',
    ],
  },
  {
    id: 'multiclipboard',
    slug: 'multiclipboard',
    name: 'MultiClipboard',
    tagline: 'Modern Chrome Extension for Smart Multi-Item Clipboard Management',
    category: 'Developer Tools',
    categoryColor: 'text-amber-400',
    categoryBg: 'bg-amber-400/10 border-amber-400/20',
    status: 'Published',
    github: 'https://github.com/mhashiq/MultiClipboard',
    live: 'https://chromewebstore.google.com/detail/naigcmklidmmeinjpllcnbodpbdndbof',
    liveLabel: 'Chrome Web Store',
    icon: `<svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>`,
    summary: 'Manifest V3 Chrome Extension for multi-item clipboard history, smart snippet categorization, and rich-text/plain-text formatting.',
    tech: ['JavaScript (ES6+)', 'Manifest V3', 'Web Extension API', 'HTML5/CSS3', 'Chrome Storage API'],
    description: 'Architected and published a Manifest V3 Chrome Extension for multi-item clipboard history, smart snippet categorization, and rich-text/plain-text formatting. Integrated client-side NLP algorithms for automated content tagging, fast search indexing, and real-time synchronization, delivering an optimized productivity workflow.',
    highlights: [
      'Persistent multi-item clipboard history with categorization',
      'Smart NLP-based automated content tagging',
      'Rich-text and plain-text format toggle per clipboard item',
      'Fast full-text search indexing across clipboard items',
      'Real-time synchronization via Chrome Storage API',
      'Manifest V3 security-first extension architecture',
    ],
  },
  {
    id: 'statpilot',
    slug: 'statpilot',
    name: 'StatPilot 🧭',
    tagline: 'Automated, Transparent Statistical Analysis & Decision Engine',
    category: 'Data Science',
    categoryColor: 'text-indigo-400',
    categoryBg: 'bg-indigo-400/10 border-indigo-400/20',
    status: 'Published',
    github: 'https://github.com/mhashiq/statpilot',
    live: 'https://pypi.org/project/statpilot/',
    liveLabel: 'PyPI Package',
    icon: `<svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`,
    summary: 'Automated statistical analysis engine evaluating distribution normality and variance homogeneity to pick optimal parametric or non-parametric tests with audit-ready reports.',
    tech: ['Python', 'Pandas', 'SciPy', 'Rich CLI', 'Seaborn', 'PyTest', 'CLI & API'],
    description: 'StatPilot simplifies statistical workflows by evaluating dataset distributions (Shapiro-Wilk & Levene\'s test), selecting appropriate parametric or non-parametric tests, computing effect sizes, and generating publication-ready Markdown reports and rich terminal plots.',
    highlights: [
      'Automated statistical decision engine & diagnostic audit trail',
      'Shapiro-Wilk normality & Levene\'s variance homogeneity diagnostics',
      'Parametric & Non-Parametric test selection with effect size metrics',
      'Publication-ready Markdown report generator for manuscripts',
      'Rich terminal summary tables and Seaborn distribution plots',
      'Full Python API and CLI tool integration',
    ],
  },
];
---

<BaseLayout title="AuthBrain | Products — Engineering at Depth" description="Five production-grade systems spanning enterprise authentication, biometric fraud detection, 3D medical imaging AI, developer tooling, and automated statistical science.">
  <Header />
  <main>

    <!-- Page Hero -->
    <section class="mx-auto max-w-7xl px-4 pt-16 pb-12 sm:px-6 lg:px-8 lg:pt-24">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-mono uppercase tracking-[0.25em] text-white/[0.72] mb-6">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          Flagship Engineering
        </span>
        <h1 class="text-4xl font-semibold tracking-[-0.04em] text-white sm:text-5xl lg:text-6xl mb-4">
          Products
        </h1>
        <p class="text-base leading-7 text-white/[0.68] sm:text-lg max-w-2xl">
          Five production-grade systems engineered at the intersection of enterprise security, clinical AI, developer infrastructure, and statistical science. Each product represents deep applied research shipped into real-world deployment.
        </p>
      </div>
    </section>

    <!-- Products Grid -->
    <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
        {products.map((product) => (
          <div class="group relative flex flex-col overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04]">

            <!-- Top Row: Icon + Status + Category -->
            <div class="flex items-start justify-between mb-6">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-white">
                <Fragment set:html={product.icon} />
              </div>
              <div class="flex flex-col items-end gap-2">
                <span class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-mono uppercase tracking-widest ${product.categoryBg} ${product.categoryColor}`}>
                  {product.category}
                </span>
                <span class={`rounded-full px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wide ${
                  product.status === 'Production' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' :
                  product.status === 'Published' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' :
                  'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                }`}>{product.status}</span>
              </div>
            </div>

            <!-- Product Name & Tagline -->
            <h2 class="text-2xl font-semibold text-white mb-1 transition-colors group-hover:text-white">{product.name}</h2>
            <p class="text-xs font-mono text-white/50 mb-4 leading-relaxed">{product.tagline}</p>
            <p class="text-sm leading-6 text-white/[0.70] mb-6">{product.summary}</p>

            <!-- Tech Stack Pills -->
            <div class="flex flex-wrap gap-2 mb-8">
              {product.tech.map((t) => (
                <span class="rounded-full border border-white/[0.08] bg-white/[0.03] px-3 py-1 text-[11px] font-mono text-white/60">{t}</span>
              ))}
            </div>

            <!-- Bottom CTAs -->
            <div class="mt-auto flex flex-wrap items-center gap-3">
              <a
                href={`${import.meta.env.BASE_URL}products/${product.slug}/`}
                class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/[0.12] px-5 py-2.5 text-xs font-medium text-white/80 transition hover:bg-white/10 hover:text-white"
              >
                View Full Details
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
              {product.live && (
                <a
                  href={product.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-accent/10 border border-accent/20 px-5 py-2.5 text-xs font-medium text-accent transition hover:bg-accent/20 hover:text-white"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                  {product.liveLabel || 'Live App'}
                </a>
              )}
              {product.github !== '#' && (
                <a
                  href={product.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-transparent px-5 py-2.5 text-xs font-medium text-white/60 transition hover:border-white/20 hover:text-white"
                >
                  <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  GitHub
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
