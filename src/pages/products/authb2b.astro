---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'AuthB2B',
  'applicationCategory': 'SecurityApplication',
  'operatingSystem': 'Linux, Docker, Cloud',
  'description': 'High-concurrency B2B authentication engine integrating real-time AI security models with zero-trust access control.',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD'
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://authbrain.tech/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Products', 'item': 'https://authbrain.tech/products/' },
    { '@type': 'ListItem', 'position': 3, 'name': 'AuthB2B', 'item': 'https://authbrain.tech/products/authb2b/' }
  ]
};
---

<BaseLayout
  title="AuthB2B | Enterprise B2B AI-Driven Adaptive Authentication Platform"
  description="High-concurrency B2B authentication engine integrating real-time AI security models with zero-trust access control."
  jsonLdSchema={[softwareSchema, breadcrumbSchema]}
>
  <Header />
  <main class="bg-[#FAFAFA] text-gray-900">

    <!-- 1. Breadcrumb -->
    <nav class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-xs font-medium text-gray-500">
        <li><a href={import.meta.env.BASE_URL} class="hover:text-blue-600 transition">Home</a></li>
        <li>/</li>
        <li><a href={`${import.meta.env.BASE_URL}products/`} class="hover:text-blue-600 transition">Products</a></li>
        <li>/</li>
        <li class="text-gray-900 font-semibold">AuthB2B</li>
      </ol>
    </nav>

    <!-- 2. Hero Block -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10 border-b border-gray-200">
      <div class="max-w-4xl space-y-4">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-700">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Production
          </span>
          <span class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-gray-500">
            ENTERPRISE SECURITY
          </span>
        </div>

        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
          AuthB2B
        </h1>

        <p class="text-lg font-semibold text-gray-700">
          Enterprise B2B AI-Driven Adaptive Authentication Platform
        </p>

        <p class="text-base leading-relaxed text-gray-600 max-w-3xl">
          AuthB2B is a high-concurrency B2B authentication engine architected to integrate real-time AI security models into enterprise access control. By deploying unsupervised machine learning models, AuthB2B continuously evaluates login risk, session anomaly scores, and contextual user behavior deviations to enforce zero-trust security without impeding authorized workflows.
        </p>

        <!-- Primary CTA Row -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href="https://github.com/mhashiq/AuthB2B"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-gray-300 bg-white px-5 py-3 text-xs font-semibold text-gray-700 hover:bg-gray-50 shadow-xs transition"
          >
            <svg class="h-4 w-4 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>View on GitHub</span>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}contact/`}
            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition"
          >
            <span>Request Enterprise Deployment</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 3. Tech Stack Grid -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 border-b border-gray-200">
      <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-4">Production Tech Architecture</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-6">
        {[
          { name: 'Python 3.11', desc: 'Core ML Engine' },
          { name: 'PyTorch', desc: 'Anomaly Inference' },
          { name: 'FastAPI', desc: 'Sub-50ms Async REST' },
          { name: 'OAuth2/OIDC', desc: 'SSO Protocol' },
          { name: 'Docker', desc: 'Containerized Deployment' },
          { name: 'PostgreSQL', desc: 'Audit Logs & Policy' },
        ].map((t) => (
          <div class="rounded-xl border border-gray-200 bg-white p-3.5 text-center shadow-xs">
            <p class="text-xs font-mono font-bold text-gray-900">{t.name}</p>
            <p class="text-[10px] text-gray-500 font-medium mt-0.5">{t.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Key Capabilities & Outcomes -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 border-b border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Key Engineering Capabilities</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs">
          <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm mb-3">⚡</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Sub-50ms Authentication Decisions</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Delivers end-to-end access decisions — including ML risk inference and policy evaluations — in under 50ms at enterprise concurrency levels.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs">
          <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm mb-3">🛡️</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Zero-Trust Session Validation</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Enforces continuous risk-based authentication without implicit trust, eliminating account takeover vulnerabilities across distributed teams.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs">
          <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm mb-3">🔑</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">OAuth2 & OIDC SSO Integration</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Full compliance with standard OAuth2 authorization flows and OIDC identity token issuance for seamless integration with existing identity providers.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs">
          <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm mb-3">📊</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Dynamic RBAC & ABAC Policies</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Evaluates role and attribute-based access control rules dynamically per request based on environmental threat telemetry.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. Target Use Cases -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 border-b border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Built For Enterprise Teams</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs text-center">
          <div class="text-2xl mb-2">🏢</div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">Chief Information Security Officers</h3>
          <p class="text-xs text-gray-600">Standardize zero-trust access control across complex multi-cloud and legacy corporate endpoints.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs text-center">
          <div class="text-2xl mb-2">💻</div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">Security Engineering Leads</h3>
          <p class="text-xs text-gray-600">Deploy high-performance REST microservices with pre-built PyTorch threat detection hooks.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs text-center">
          <div class="text-2xl mb-2">🔒</div>
          <h3 class="text-sm font-bold text-gray-900 mb-1">B2B SaaS Architect Teams</h3>
          <p class="text-xs text-gray-600">Embed adaptive OAuth2 authentication into multi-tenant enterprise software architectures.</p>
        </div>
      </div>
    </section>

    <!-- 6. Related Products -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 border-b border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Related Platforms</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <a href={`${import.meta.env.BASE_URL}products/authfacegraph/`} class="group rounded-2xl border border-gray-200 bg-white p-6 shadow-xs hover:border-blue-300 hover:shadow-md transition">
          <span class="inline-block rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-700 mb-2">Production</span>
          <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-600 transition">AuthFaceGraph</h3>
          <p class="text-xs text-gray-600 mt-1">Biometric Facial Recognition & Graph Neural Network Security</p>
        </a>

        <a href={`${import.meta.env.BASE_URL}products/multiclipboard/`} class="group rounded-2xl border border-gray-200 bg-white p-6 shadow-xs hover:border-blue-300 hover:shadow-md transition">
          <span class="inline-block rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-[10px] font-semibold text-blue-700 mb-2">Published</span>
          <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-600 transition">MultiClipboard</h3>
          <p class="text-xs text-gray-600 mt-1">Modern Chrome Extension for Smart Multi-Item Clipboard Management</p>
        </a>
      </div>
    </section>

    <!-- 7. Final CTA Band -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-blue-200 bg-blue-50/60 p-8 text-center shadow-xs">
        <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl mb-2">
          Interested in deploying AuthB2B for your organization?
        </h2>
        <p class="text-sm text-gray-600 max-w-xl mx-auto mb-6">
          Schedule a technical deep-dive with our security engineering team to discuss custom integrations or on-premise licensing.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}contact/`}
          class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-7 py-3.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 transition"
        >
          Schedule Technical Demo
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
