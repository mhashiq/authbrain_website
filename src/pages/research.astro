---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="AuthBrain | Research, Books & Peer-Reviewed Publications" description="Explore our peer-reviewed publications, books, and computer science research driving enterprise AI and zero-trust security.">
  <Header />
  <main class="bg-[#FAFAFA] text-gray-900">
    <!-- 1. Hero Section -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12 border-b border-gray-200 bg-white">
      <div class="text-center max-w-4xl mx-auto space-y-6">
        <span class="inline-flex rounded-full bg-blue-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-700">
          Research-First AI Engineering
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
          Peer-Reviewed Science & Enterprise AI Research
        </h1>
        <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          AuthBrain grounds every enterprise algorithm in peer-reviewed computer science and biomedical AI research published in leading international journals.
        </p>
      </div>

      <!-- Research Statistics Bar -->
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 border border-gray-200 bg-gray-50/70 p-6 rounded-2xl">
        <div class="text-center">
          <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl">3</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-gray-500">Published AI Books</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl">50+</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-gray-500">Peer-Reviewed Papers</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl">1,200+</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-gray-500">Academic Citations</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl">h-25</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-gray-500">Research Index</p>
        </div>
      </div>
    </section>

    <!-- 2. Featured Books -->
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Featured Books & Publications</h2>
      </div>
      <div class="grid gap-8 lg:grid-cols-3">
        <!-- Book 1 -->
        <a href="https://www.routledge.com/Brain-Networks-in-Neuroscience-Personalization-Unveiled-Via-Artificial-Intelligence/Hassan-Yasmin-Islam-Bairagi-Aung/p/book/9788770047364" target="_blank" class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition hover:shadow-md hover:border-blue-300">
          <div class="bg-gray-50 py-6 flex items-center justify-center rounded-xl mb-5">
            <img src={`${import.meta.env.BASE_URL}Brain-network-book.webp`} alt="Brain Networks in Neuroscience" class="h-64 w-44 object-cover shadow-md transition duration-300 group-hover:scale-105 rounded-sm" />
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">AI • Neuroscience • Networks</p>
            <h3 class="text-xl font-bold text-gray-900">Brain Networks in Neuroscience</h3>
            <p class="mt-2 text-sm text-gray-600">Personalization Unveiled Via Artificial Intelligence (2025)</p>
            <p class="mt-4 text-sm font-semibold text-blue-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Publication &rarr;</p>
          </div>
        </a>

        <!-- Book 2 -->
        <a href="https://link.springer.com/book/10.1007/978-3-032-04315-3" target="_blank" class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition hover:shadow-md hover:border-blue-300">
          <div class="bg-gray-50 py-6 flex items-center justify-center rounded-xl mb-5">
            <img src={`${import.meta.env.BASE_URL}GNN-book.webp`} alt="Graph Neural Networks" class="h-64 w-44 object-cover shadow-md transition duration-300 group-hover:scale-105 rounded-sm" />
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">GNN • Diagnostics • Brain</p>
            <h3 class="text-xl font-bold text-gray-900">Graph Neural Networks for Neurological Disorders</h3>
            <p class="mt-2 text-sm text-gray-600">Fundamentals, Applications and Benefits in Research (2025)</p>
            <p class="mt-4 text-sm font-semibold text-blue-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Publication &rarr;</p>
          </div>
        </a>

        <!-- Book 3 -->
        <a href="https://link.springer.com/book/10.1007/978-3-032-12470-8" target="_blank" class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition hover:shadow-md hover:border-blue-300">
          <div class="bg-gray-50 py-6 flex items-center justify-center rounded-xl mb-5">
            <img src={`${import.meta.env.BASE_URL}Heart-book.webp`} alt="Deep Learning in Cardiovascular Health" class="h-64 w-44 object-cover shadow-md transition duration-300 group-hover:scale-105 rounded-sm" />
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">Cardiovascular • ECG • AI</p>
            <h3 class="text-xl font-bold text-gray-900">Deep Learning in Cardiovascular Health</h3>
            <p class="mt-2 text-sm text-gray-600">Sustainable AI Approaches for Heart Disease Diagnosis (2026)</p>
            <p class="mt-4 text-sm font-semibold text-blue-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Publication &rarr;</p>
          </div>
        </a>
      </div>
    </section>

    <!-- 3. Google Scholar CTA -->
    <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8 text-center">
      <div class="rounded-3xl border border-blue-200 bg-blue-50/60 p-8 lg:p-10 shadow-xs space-y-4">
        <h2 class="text-3xl font-bold text-gray-900">Explore Full Academic Profile</h2>
        <p class="text-base text-gray-600 max-w-xl mx-auto leading-relaxed">
          Access complete citation metrics, co-authors, and peer-reviewed journals on Google Scholar.
        </p>
        <div>
          <a
            href="https://scholar.google.com/citations?user=Ts2F72QAAAAJ"
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center rounded-xl bg-blue-600 px-7 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-blue-700 transition"
          >
            Open Google Scholar Profile &rarr;
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>