---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="AuthBrain | AI-Powered Healthcare Intelligence" description="Transform healthcare data into intelligent decisions with AI-powered analytics, predictive insights, and medical imaging intelligence.">
  <Header />
  <main>
    <!-- 1. Hero Section -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <div class="space-y-8">
          <span class="inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-mono uppercase tracking-[0.28em] text-white/[0.72]">
            Smarter Healthcare Through AI
          </span>
          <div class="space-y-5">
            <h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-[-0.05em] text-white sm:text-6xl lg:text-7xl">
              Transform Healthcare Data into Intelligent Decisions.
            </h1>
            <p class="max-w-2xl text-base leading-7 text-white/[0.72] sm:text-lg">
              AI-powered healthcare analytics, predictive insights, medical imaging intelligence, and operational optimization solutions for hospitals, clinics, researchers, and healthcare organizations.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href={`${import.meta.env.BASE_URL}contact/`} class="inline-flex items-center rounded-full bg-accent px-5 py-3 text-sm font-medium text-white transition hover:translate-y-[-1px] hover:bg-accent/90">
              Request a Demo
            </a>
            <a href={`${import.meta.env.BASE_URL}services/`} class="inline-flex items-center rounded-full border border-white/[0.12] bg-white/5 px-5 py-3 text-sm font-medium text-white/[0.80] transition hover:border-white/[0.25] hover:bg-white/[0.08]">
              View Solutions
            </a>
          </div>
        </div>

        <div class="clinical-frame flex items-center justify-center rounded-[2rem] border border-white/[0.1] bg-white/[0.02] p-2 shadow-2xl">
          <img src={`${import.meta.env.BASE_URL}interactive-dashboard.png`} alt="Interactive Dashboard & Imaging Analysis Preview" class="h-full w-full rounded-[1.5rem] object-cover" />
        </div>
      </div>
    </section>

    <!-- 2. Trust & Credibility Section -->
    <section class="border-y border-white/[0.08] bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <p class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-white/[0.5]">Trusted by Hospitals, Research Institutes, and Pharmas</p>
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:gap-12">
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">500M+</p>
            <p class="mt-2 text-sm text-white/[0.6]">Records Processed</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">150+</p>
            <p class="mt-2 text-sm text-white/[0.6]">AI Models Deployed</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">98%</p>
            <p class="mt-2 text-sm text-white/[0.6]">Client Satisfaction</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">25+</p>
            <p class="mt-2 text-sm text-white/[0.6]">Countries Served</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Core Solutions Section -->
    <section class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <!-- Background Health Vibe Element -->
      <div class="absolute inset-0 -z-10 flex items-center justify-center opacity-[0.02] pointer-events-none">
        <svg class="h-[40rem] w-[40rem]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 10.5h-5.5V5h-3v5.5H5v3h5.5V19h3v-5.5H19v-3z"/>
        </svg>
      </div>

      <div class="mb-16 text-center">
        <span class="inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-mono uppercase tracking-widest text-accent mb-4">
          Core Capabilities
        </span>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">AI Healthcare Solutions</h2>
        <p class="mt-4 text-base text-white/[0.6] max-w-2xl mx-auto">Empowering modern healthcare through deep learning, predictive modeling, and intelligent operational analytics.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Clinical Decision Support</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">Help physicians make faster and more accurate decisions using AI-driven recommendations.</p>
        </div>

        <!-- Card 2 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Healthcare Data Analytics</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">Analyze patient, operational, and clinical data through powerful dashboards.</p>
        </div>

        <!-- Card 3 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Predictive Healthcare</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">Predict disease risks, patient readmissions, and treatment outcomes proactively.</p>
        </div>

        <!-- Card 4 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Medical Imaging AI</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">Advanced analysis for CT, MRI, X-ray, and Ultrasound imaging.</p>
        </div>

        <!-- Card 5 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Population Health</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">Monitor healthcare trends and improve community health outcomes.</p>
        </div>

        <!-- Card 6 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Compliance & Security</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">HIPAA/GDPR-compliant AI solutions with enterprise-grade security.</p>
        </div>
      </div>
    </section>

    <!-- 4. Why Choose Us -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-10 text-center space-y-4">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Intelligent Healthcare Transformation</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Advanced AI Algorithms</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Healthcare Industry Expertise</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Real-Time Analytics</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Secure Cloud Infrastructure</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Custom AI Development</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Regulatory Compliance</span>
        </div>
      </div>
    </section>

    <!-- 5. Industry Use Cases -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Solutions for Every Healthcare Sector</h2>
      </div>
      <div class="grid gap-6 lg:grid-cols-4">
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Hospitals</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Resource optimization</li>
            <li>• Patient flow management</li>
            <li>• Readmission prediction</li>
          </ul>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Diagnostic Centers</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Imaging analysis</li>
            <li>• Reporting automation</li>
            <li>• Quality assurance</li>
          </ul>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Pharmaceuticals</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Clinical trial analytics</li>
            <li>• Drug discovery support</li>
            <li>• Market intelligence</li>
          </ul>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Research Institutions</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Large-scale data analysis</li>
            <li>• AI research support</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. Data Analytics Platform Showcase -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="clinical-frame rounded-[2rem] p-8 lg:p-12">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div class="space-y-6">
            <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Unified Healthcare Intelligence Platform</h2>
            <div class="grid grid-cols-2 gap-4 text-sm text-white/[0.72]">
              <div class="rounded-lg bg-white/5 p-4">Patient Analytics</div>
              <div class="rounded-lg bg-white/5 p-4">Disease Prediction</div>
              <div class="rounded-lg bg-white/5 p-4">Medical Imaging Results</div>
              <div class="rounded-lg bg-white/5 p-4">Operational KPIs</div>
              <div class="rounded-lg bg-white/5 p-4">Financial Analytics</div>
              <div class="rounded-lg bg-white/5 p-4">Resource Utilization</div>
            </div>
          </div>
          <div class="clinical-frame flex items-center justify-center rounded-[1.5rem] border border-white/[0.1] bg-white/[0.02] p-2 shadow-2xl">
            <img src={`${import.meta.env.BASE_URL}model-perf.png`} alt="Healthcare Analytics Platform Performance" class="w-full h-auto rounded-[1rem] object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Healthcare AI Process -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">How It Works</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6 text-center">
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 1</p><p class="mt-2 text-sm text-white">Collect Healthcare Data</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 2</p><p class="mt-2 text-sm text-white">Clean & Integrate Data</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 3</p><p class="mt-2 text-sm text-white">AI Model Processing</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 4</p><p class="mt-2 text-sm text-white">Predictive Analytics</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 5</p><p class="mt-2 text-sm text-white">Actionable Insights</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 6</p><p class="mt-2 text-sm text-white">Continuous Optimization</p></div>
      </div>
    </section>

    <!-- 7.5 Enterprise & Business AI Solutions -->
    <section class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-t border-white/[0.08]">
      <div class="mb-16 text-center">
        <span class="inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-mono uppercase tracking-widest text-accent mb-4">
          Cross-Industry Expertise
        </span>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Enterprise AI & Business Automation</h2>
        <p class="mt-4 text-base text-white/[0.6] max-w-2xl mx-auto">Scaling our deep learning expertise beyond healthcare to deliver measurable ROI through predictive modeling, automated workflows, and data engineering.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        
        <!-- Card 1 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">AI Automation & Agents</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">Automatically read emails, generate reports, and handle operations with Custom AI Chatbots and Support Agents.</p>
        </div>

        <!-- Card 2 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="relative z-10 text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Predictive Forecasting</h3>
          <p class="relative z-10 mt-4 text-sm leading-7 text-white/[0.68]">Answer critical business questions: forecast sales, predict customer churn, and optimize inventory models.</p>
        </div>

        <!-- Card 3 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04] hover:shadow-2xl hover:shadow-accent/10">
          <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/10 blur-[50px] transition-all duration-500 group-hover:bg-accent/20"></div>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
