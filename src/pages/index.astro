---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="AuthBrain | Zero-Trust Authentication & Clinical AI for Healthcare & Finance" 
  description="Unified predictive AI and zero-trust access control for hospitals and financial enterprises. Sub-50ms authentication, HIPAA-compliant clinical AI, on-premise deployment."
>
  <Header />
  <main class="bg-[#FAFAFA] text-gray-900">
    
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden py-8 lg:py-12 border-b border-gray-200/60 bg-gradient-to-b from-white to-[#FAFAFA]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:items-center">
          
          <!-- Hero Copy -->
          <div class="space-y-8">
            <div class="space-y-4">
              <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.12]">
                Unified Predictive AI and Zero-Trust Authentication for Enterprise Systems.
              </h1>
              <p class="text-base sm:text-lg leading-relaxed text-gray-600 max-w-2xl font-normal">
                AuthBrain unifies clinical prediction engines and risk-based access control under one neural architecture. We enable health systems and financial enterprises to secure sensitive identities while anticipating critical clinical and operational outcomes. Deploy on-premise or in private cloud with zero compromise on speed, precision, or compliance.
              </p>
            </div>

            <div class="flex flex-wrap gap-4 pt-2">
              <a 
                href={`${import.meta.env.BASE_URL}contact/`} 
                class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-6 py-3.5 text-base font-medium text-white shadow-md transition-all hover:bg-blue-700 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              >
                Schedule Technical Demo
                <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a 
                href={`${import.meta.env.BASE_URL}services/`} 
                class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-6 py-3.5 text-base font-medium text-gray-700 shadow-xs transition-all hover:bg-gray-50 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-300"
              >
                Explore Platform Capabilities
              </a>
            </div>
          </div>

          <!-- Hero Visual: Light Enterprise Dashboard Mockup Card -->
          <div class="relative">
            <!-- Backdrop Subtle Glow -->
            <div class="absolute -inset-4 bg-blue-500/5 rounded-3xl blur-2xl -z-10"></div>
            
            <div class="rounded-2xl border border-gray-200/90 bg-white p-6 shadow-xl shadow-gray-200/50">
              <!-- Dashboard Header -->
              <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="flex gap-1.5">
                    <span class="h-3 w-3 rounded-full bg-red-400"></span>
                    <span class="h-3 w-3 rounded-full bg-amber-400"></span>
                    <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
                  </div>
                  <span class="font-mono text-xs font-semibold tracking-wider text-gray-500 uppercase">
                    AUTHBRAIN_CORE // TELEMETRY_FEED
                  </span>
                </div>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 border border-emerald-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Active Stream
                </span>
              </div>

              <!-- 3 Metric Stream Rows -->
              <div class="space-y-3.5">
                <!-- Row 1: Identity Verify -->
                <div class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 transition-all hover:bg-gray-50 hover:border-gray-200">
                  <div class="flex items-center justify-between text-xs text-gray-500 font-mono mb-1.5">
                    <span class="font-semibold text-gray-600">Identity Verify — Adaptive Auth</span>
                    <span class="rounded-md bg-blue-100/80 px-2 py-0.5 text-[11px] font-medium text-blue-700 font-mono">14ms</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-gray-900">Risk Score: 0.012 (Verified Clear)</span>
                    <span class="inline-flex items-center text-xs font-medium text-emerald-600">
                      <svg class="mr-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      Allow Access
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-gray-500">Continuous biometrics matched • Zero session friction</p>
                </div>

                <!-- Row 2: Clinical Prediction -->
                <div class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 transition-all hover:bg-gray-50 hover:border-gray-200">
                  <div class="flex items-center justify-between text-xs text-gray-500 font-mono mb-1.5">
                    <span class="font-semibold text-gray-600">Clinical Prediction — Longitudinal EHR</span>
                    <span class="rounded-md bg-blue-100/80 px-2 py-0.5 text-[11px] font-medium text-blue-700 font-mono">48ms</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-gray-900">Readmission Risk: 84% (High)</span>
                    <span class="inline-flex items-center text-xs font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                      Care Alert Dispatched
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-gray-500">Longitudinal vital trend anomaly flagged for clinical team</p>
                </div>

                <!-- Row 3: Imaging AI -->
                <div class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 transition-all hover:bg-gray-50 hover:border-gray-200">
                  <div class="flex items-center justify-between text-xs text-gray-500 font-mono mb-1.5">
                    <span class="font-semibold text-gray-600">Imaging AI — 3D CT Volumetric</span>
                    <span class="rounded-md bg-blue-100/80 px-2 py-0.5 text-[11px] font-medium text-blue-700 font-mono">110ms</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-gray-900">Liver Mesh Generated (1,420 cm³)</span>
                    <span class="inline-flex items-center text-xs font-medium text-blue-600">
                      0.4mm Precision
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-gray-500">Surgical resection boundaries calculated for PACS DICOM</p>
                </div>
              </div>

              <!-- Sparkline Telemetry Footer -->
              <div class="mt-4 rounded-xl border border-gray-100 bg-blue-50/40 p-3.5">
                <div class="flex items-center justify-between text-xs text-gray-600 mb-2 font-mono">
                  <span class="font-semibold uppercase text-[11px]">Latency Telemetry (sub-50ms target)</span>
                  <span class="font-bold text-blue-700">Avg: 16.4ms</span>
                </div>
                <svg class="h-10 w-full text-blue-600 stroke-current" fill="none" viewBox="0 0 400 40">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M0 28 L40 22 L80 30 L120 12 L160 18 L200 8 L240 16 L280 10 L320 20 L360 6 L400 14" />
                </svg>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. TRUST STATS BAR -->
    <section class="py-7 border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">
          Enterprise Infrastructure Performance at Scale
        </p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-8">
          
          <div class="rounded-2xl border border-gray-200/80 bg-gray-50/70 p-6 text-center shadow-xs transition-all hover:bg-white hover:shadow-md hover:border-blue-200">
            <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl lg:text-5xl tracking-tight count-stat" data-target="500">500M+</p>
            <p class="mt-2 text-xs sm:text-sm font-medium text-gray-600">Clinical & Security Records Processed</p>
          </div>

          <div class="rounded-2xl border border-gray-200/80 bg-gray-50/70 p-6 text-center shadow-xs transition-all hover:bg-white hover:shadow-md hover:border-blue-200">
            <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl lg:text-5xl tracking-tight count-stat" data-target="150">150+</p>
            <p class="mt-2 text-xs sm:text-sm font-medium text-gray-600">Production AI Models Deployed</p>
          </div>

          <div class="rounded-2xl border border-gray-200/80 bg-gray-50/70 p-6 text-center shadow-xs transition-all hover:bg-white hover:shadow-md hover:border-blue-200">
            <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl lg:text-5xl tracking-tight count-stat" data-target="98">98%</p>
            <p class="mt-2 text-xs sm:text-sm font-medium text-gray-600">Verified Client Retention Rate</p>
          </div>

          <div class="rounded-2xl border border-gray-200/80 bg-gray-50/70 p-6 text-center shadow-xs transition-all hover:bg-white hover:shadow-md hover:border-blue-200">
            <p class="text-3xl font-extrabold text-blue-600 sm:text-4xl lg:text-5xl tracking-tight count-stat" data-target="25">25+</p>
            <p class="mt-2 text-xs sm:text-sm font-medium text-gray-600">Global Enterprise Markets Served</p>
          </div>

        </div>
      </div>
    </section>

    <!-- 3. CORE CAPABILITIES (Unified Intelligence Architecture) -->
    <section class="py-10 lg:py-14 border-b border-gray-200 bg-[#FAFAFA]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mb-16">
          <span class="inline-flex rounded-full bg-blue-100/80 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-700 mb-3">
            Core Capabilities
          </span>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Unified Intelligence Architecture
          </h2>
          <p class="mt-4 text-base sm:text-lg text-gray-600">
            Purpose-built engines designed for high-stakes healthcare analytics, clinical workflows, and zero-trust data protection.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          
          <!-- Card 1 -->
          <div class="group rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-md">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Clinical Workflow</span>
            <h3 class="text-xl font-bold text-gray-900 mt-1 mb-2">Clinical Decision Support</h3>
            <p class="text-sm leading-relaxed text-gray-600">
              Surfaces real-time clinical risk indicators inside physician workflows to prevent adverse events before medical interventions occur.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="group rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-md">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Data Pipelines</span>
            <h3 class="text-xl font-bold text-gray-900 mt-1 mb-2">Healthcare Data Analytics</h3>
            <p class="text-sm leading-relaxed text-gray-600">
              Normalizes fragmented medical records into unified pipelines, accelerating institutional reporting and operational decision-making.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="group rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-md">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Early Prevention</span>
            <h3 class="text-xl font-bold text-gray-900 mt-1 mb-2">Predictive Healthcare</h3>
            <p class="text-sm leading-relaxed text-gray-600">
              Forecasts patient deterioration and readmission risks days in advance, enabling care teams to allocate clinical resources proactively.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="group rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-md">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Radiology Precision</span>
            <h3 class="text-xl font-bold text-gray-900 mt-1 mb-2">Medical Imaging AI</h3>
            <p class="text-sm leading-relaxed text-gray-600">
              Automates 3D volumetric organ segmentation and lesion detection, decreasing radiologist review time while improving measurement accuracy.
            </p>
          </div>

          <!-- Card 5 -->
          <div class="group rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-md">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Population Care</span>
            <h3 class="text-xl font-bold text-gray-900 mt-1 mb-2">Population Health</h3>
            <p class="text-sm leading-relaxed text-gray-600">
              Stratifies health risks across regional patient networks to optimize preventive care initiatives and control chronic disease management costs.
            </p>
          </div>

          <!-- Card 6 -->
          <div class="group rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-md">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-5 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Zero-Trust Guard</span>
            <h3 class="text-xl font-bold text-gray-900 mt-1 mb-2">Compliance & Security</h3>
            <p class="text-sm leading-relaxed text-gray-600">
              Enforces continuous biometric access control and data security standards across HIPAA and GDPR-regulated enterprise environments.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- 4. SOLUTIONS OVERVIEW (Enterprise Capability Suites) -->
    <section class="py-10 lg:py-14 border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mb-16">
          <span class="inline-flex rounded-full bg-blue-100/80 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-700 mb-3">
            Solutions Overview
          </span>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Enterprise Capability Suites
          </h2>
          <p class="mt-4 text-base sm:text-lg text-gray-600">
            Four targeted software systems engineered to solve high-frequency security and clinical bottlenecks.
          </p>
        </div>

        <div class="space-y-8">
          
          <!-- Suite 1 -->
          <div class="rounded-2xl border border-gray-200 bg-gray-50/50 p-8 lg:p-10 transition-all hover:bg-white hover:shadow-lg hover:border-blue-200">
            <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Identity & Access</span>
                <h3 class="text-2xl font-bold text-gray-900 mt-1 mb-3">Adaptive Risk-Based Access Control</h3>
                <p class="text-base text-gray-600 leading-relaxed">
                  Evaluates access requests in real time by analyzing session behavior, device signatures, and network anomaly patterns. Blocks unauthorized intrusion attempts without adding friction to authorized workflows.
                </p>
                <div class="mt-6 inline-flex items-center gap-2 rounded-xl bg-blue-50 px-4 py-2.5 text-xs font-semibold text-blue-700 border border-blue-200/80 font-mono">
                  <span>TAGLINE:</span>
                  <span class="font-sans font-medium text-gray-800">Delivers sub-50ms access decisions without adding friction to legitimate user sessions.</span>
                </div>
              </div>
              <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-xs">
                <div class="flex items-center justify-between text-xs font-mono text-gray-500 mb-3">
                  <span>SESSION_RISK_EVAL</span>
                  <span class="text-emerald-600 font-semibold">PASSED</span>
                </div>
                <div class="space-y-2 text-xs">
                  <div class="flex justify-between p-2 rounded bg-gray-50">
                    <span class="text-gray-500">Device Fingerprint:</span>
                    <span class="font-mono text-gray-800">Verified Match (99.8%)</span>
                  </div>
                  <div class="flex justify-between p-2 rounded bg-gray-50">
                    <span class="text-gray-500">Behavioral Vector:</span>
                    <span class="font-mono text-gray-800 font-semibold text-blue-600">0.012 Anomaly Score</span>
                  </div>
                  <div class="flex justify-between p-2 rounded bg-gray-50">
                    <span class="text-gray-500">Decision Latency:</span>
                    <span class="font-mono text-gray-800">14.2ms</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Suite 2 -->
          <div class="rounded-2xl border border-gray-200 bg-gray-50/50 p-8 lg:p-10 transition-all hover:bg-white hover:shadow-lg hover:border-blue-200">
            <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Financial Security</span>
                <h3 class="text-2xl font-bold text-gray-900 mt-1 mb-3">Biometric & Graph-Based Fraud Detection</h3>
                <p class="text-base text-gray-600 leading-relaxed">
                  Maps facial feature vectors against relational transaction graphs to detect identity theft networks and flag synthetic identity rings before loss occurs.
                </p>
                <div class="mt-6 inline-flex items-center gap-2 rounded-xl bg-blue-50 px-4 py-2.5 text-xs font-semibold text-blue-700 border border-blue-200/80 font-mono">
                  <span>TAGLINE:</span>
                  <span class="font-sans font-medium text-gray-800">Identifies hidden identity syndicates before fraudulent transactions can settle.</span>
                </div>
              </div>
              <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-xs">
                <div class="flex items-center justify-between text-xs font-mono text-gray-500 mb-3">
                  <span>GRAPH_ANOMALY_MAP</span>
                  <span class="text-blue-600 font-semibold">SYNTHETIC_ID_DETECTOR</span>
                </div>
                <div class="space-y-2 text-xs">
                  <div class="flex justify-between p-2 rounded bg-gray-50">
                    <span class="text-gray-500">Node Cluster:</span>
                    <span class="font-mono text-gray-800">14 Linked Accounts</span>
                  </div>
                  <div class="flex justify-between p-2 rounded bg-gray-50">
                    <span class="text-gray-500">Biometric Match:</span>
                    <span class="font-mono text-rose-600 font-semibold">Conflict Flagged</span>
                  </div>
                  <div class="flex justify-between p-2 rounded bg-gray-50">
                    <span class="text-gray-500">Action:</span>
                    <span class="font-mono text-emerald-700 font-bold">Settlement Blocked</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Suite 3 -->
          <div class="rounded-2xl border border-gray-200 bg-gray-50/50 p-8 lg:p-10 transition-all hover:bg-white hover:shadow-lg hover:border-blue-200">
            <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Biomedical AI</span>
                <h3 class="text-2xl font-bold text-gray-900 mt-1 mb-3">Automated Medical Imaging Analysis</h3>
                <p class="text-base text-gray-600 leading-relaxed">
                  Performs automated 3D organ/tumor segmentation from radiological scans, returning volumetric measurements to surgical planning tools in seconds.
                </p>
                <div class="mt-6 inline-flex items-center gap-2 rounded-xl bg-blue-50 px-4 py-2.5 text-xs font-semibold text-blue-700 border border-blue-200/80 font-mono">
                  <span>TAGLINE:</span>
                  <span class="font-sans font-medium text-gray-800">Converts multi-slice scans into actionable surgical boundaries in seconds.</span>
                </div>
              </div>
              <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-xs">
                <div class="flex items-center justify-between text-xs font-mono text-gray-500 mb-3">
                  <span>DICOM_SEGMENTATION_ENGINE</span>
                  <span class="text-blue-600 font-semibold">3D_VOLUMETRIC</span>
                </div>
