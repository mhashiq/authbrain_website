---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="AuthBrain | Unified Predictive AI & Zero-Trust Security Infrastructure" description="AuthBrain unifies clinical prediction engines and risk-based access control under one neural architecture for healthcare and financial enterprise systems.">
  <Header />
  <main>
    <!-- 1. Hero Section -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="space-y-8">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-mono uppercase tracking-[0.25em] text-white/[0.75]">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Unified Enterprise AI Infrastructure
          </span>
          <div class="space-y-5">
            <h1 class="max-w-3xl text-4xl font-semibold leading-tight tracking-[-0.04em] text-white sm:text-5xl lg:text-6xl">
              Unified Predictive AI and Zero-Trust Authentication for Enterprise Systems.
            </h1>
            <p class="max-w-2xl text-base leading-7 text-white/[0.72] sm:text-lg">
              AuthBrain unifies clinical prediction engines and risk-based access control under one neural architecture. We enable health systems and financial enterprises to secure sensitive identities while anticipating critical clinical and operational outcomes. Deploy on-premise or in private cloud with zero compromise on speed, precision, or compliance.
            </p>
          </div>

          <div class="flex flex-wrap gap-4">
            <a href={`${import.meta.env.BASE_URL}contact/`} class="inline-flex items-center rounded-full bg-accent px-6 py-3.5 text-sm font-medium text-white transition hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-black">
              Schedule Technical Demo
            </a>
            <a href={`${import.meta.env.BASE_URL}services/`} class="inline-flex items-center rounded-full border border-white/[0.12] bg-white/5 px-6 py-3.5 text-sm font-medium text-white/[0.85] transition hover:border-white/[0.25] hover:bg-white/[0.08] focus:outline-none focus:ring-2 focus:ring-white/40 focus:ring-offset-2 focus:ring-offset-black">
              Explore Platform Capabilities
            </a>
          </div>
        </div>

        <!-- Hero Visual: Live Telemetry & Status Feed Data Panel (No Photography/Stock Images) -->
        <div class="rounded-[2rem] border border-white/10 bg-black/60 p-6 shadow-2xl backdrop-blur-xl">
          <!-- Panel Header -->
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-3">
              <div class="flex gap-1.5">
                <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
                <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
              </div>
              <span class="font-mono text-xs font-semibold tracking-wider text-white/60">AUTHBRAIN_CORE // ENGINE_STATUS</span>
            </div>
            <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 font-mono text-[11px] font-medium text-emerald-400 border border-emerald-500/20">ONLINE</span>
          </div>

          <!-- Live Feed Stream -->
          <div class="mt-5 space-y-3 font-mono text-xs">
            <!-- Event 1: Identity Risk Assessment -->
            <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] p-3.5 transition hover:border-white/20">
              <div class="flex items-center justify-between text-white/50 text-[11px] mb-1">
                <span>IDENTITY_VERIFY // ADAPTIVE_AUTH</span>
                <span class="text-white/40">12ms ago</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-sans text-sm font-medium text-white">Risk Score: 0.012 (Verified Clear)</span>
                <span class="rounded bg-emerald-500/10 px-2 py-0.5 text-[10px] text-emerald-400 border border-emerald-500/20">ALLOW [14ms]</span>
              </div>
              <p class="mt-1 font-sans text-xs text-white/60">Device signature matched • Behavioral vector verified</p>
            </div>

            <!-- Event 2: Clinical Deterioration Prediction -->
            <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] p-3.5 transition hover:border-white/20">
              <div class="flex items-center justify-between text-white/50 text-[11px] mb-1">
                <span>CLINICAL_PRED // LONGITUDINAL_EHR</span>
                <span class="text-white/40">48ms ago</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-sans text-sm font-medium text-white">Readmission Risk: 84% (High)</span>
                <span class="rounded bg-amber-500/10 px-2 py-0.5 text-[10px] text-amber-400 border border-amber-500/20">EHR ALERT DISPATCHED</span>
              </div>
              <p class="mt-1 font-sans text-xs text-white/60">Longitudinal vital trend anomaly flagged for care team</p>
            </div>

            <!-- Event 3: 3D Image Segmentation -->
            <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] p-3.5 transition hover:border-white/20">
              <div class="flex items-center justify-between text-white/50 text-[11px] mb-1">
                <span>IMAGING_AI // 3D_CT_VOLUMETRIC</span>
                <span class="text-white/40">110ms ago</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-sans text-sm font-medium text-white">Liver Mesh Generated (1,420 cm³)</span>
                <span class="rounded bg-blue-500/10 px-2 py-0.5 text-[10px] text-blue-400 border border-blue-500/20">0.4mm PRECISION</span>
              </div>
              <p class="mt-1 font-sans text-xs text-white/60">Surgical resection boundaries calculated for PACS</p>
            </div>
          </div>

          <!-- Real-Time Telemetry Sparkline -->
          <div class="mt-5 rounded-xl border border-white/10 bg-white/[0.02] p-4">
            <div class="flex items-center justify-between text-xs text-white/60 mb-2">
              <span class="font-mono text-[11px]">LATENCY TELEMETRY (SUB-50MS TARGET)</span>
              <span class="font-mono text-emerald-400">AVG: 16.4ms</span>
            </div>
            <svg class="h-12 w-full text-accent" fill="none" viewBox="0 0 400 50" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M0 35 L40 30 L80 38 L120 18 L160 25 L200 12 L240 22 L280 15 L320 28 L360 10 L400 20" />
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Trust Stats Bar -->
    <section class="border-y border-white/[0.08] bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <p class="mb-8 text-center text-xs font-mono uppercase tracking-[0.25em] text-white/[0.5]">Proven Infrastructure at Enterprise Scale</p>
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:gap-12">
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">500M+</p>
            <p class="mt-2 text-sm text-white/[0.6]">Clinical & Security Records Processed</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">150+</p>
            <p class="mt-2 text-sm text-white/[0.6]">Production AI Models Deployed</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">98%</p>
            <p class="mt-2 text-sm text-white/[0.6]">Verified Client Retention Rate</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">25+</p>
            <p class="mt-2 text-sm text-white/[0.6]">Global Enterprise Markets Served</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Core Capabilities (6 Cards) -->
    <section class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <span class="inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-mono uppercase tracking-widest text-accent mb-4">
          Core Capabilities
        </span>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Unified Intelligence Architecture</h2>
        <p class="mt-4 text-base text-white/[0.6] max-w-2xl mx-auto">Purpose-built engines designed for high-stakes healthcare analytics, clinical workflows, and zero-trust data protection.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04]">
          <div class="mb-4 inline-block rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-[11px] font-mono text-accent">Clinical Workflow Optimization</div>
          <h3 class="text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Clinical Decision Support</h3>
          <p class="mt-4 text-sm leading-6 text-white/[0.68]">Surfaces real-time clinical risk indicators inside physician workflows to prevent adverse events before medical interventions occur.</p>
        </div>

        <!-- Card 2 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04]">
          <div class="mb-4 inline-block rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-[11px] font-mono text-accent">Enterprise Data Intelligence</div>
          <h3 class="text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Healthcare Data Analytics</h3>
          <p class="mt-4 text-sm leading-6 text-white/[0.68]">Normalizes fragmented medical records into unified pipelines, accelerating institutional reporting and operational decision-making.</p>
        </div>

        <!-- Card 3 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04]">
          <div class="mb-4 inline-block rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-[11px] font-mono text-accent">Early Risk Mitigation</div>
          <h3 class="text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Predictive Healthcare</h3>
          <p class="mt-4 text-sm leading-6 text-white/[0.68]">Forecasts patient deterioration and readmission risks days in advance, enabling care teams to allocate clinical resources proactively.</p>
        </div>

        <!-- Card 4 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04]">
          <div class="mb-4 inline-block rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-[11px] font-mono text-accent">Precision Radiographic Analysis</div>
          <h3 class="text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Medical Imaging AI</h3>
          <p class="mt-4 text-sm leading-6 text-white/[0.68]">Automates 3D volumetric organ segmentation and lesion detection, decreasing radiologist review time while improving measurement accuracy.</p>
        </div>

        <!-- Card 5 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04]">
          <div class="mb-4 inline-block rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-[11px] font-mono text-accent">Cohort Risk Stratification</div>
          <h3 class="text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Population Health</h3>
          <p class="mt-4 text-sm leading-6 text-white/[0.68]">Stratifies health risks across regional patient networks to optimize preventive care initiatives and control chronic disease management costs.</p>
        </div>

        <!-- Card 6 -->
        <div class="group relative overflow-hidden rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.04]">
          <div class="mb-4 inline-block rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-[11px] font-mono text-accent">Zero-Trust Identity Control</div>
          <h3 class="text-xl font-semibold text-white transition-colors duration-300 group-hover:text-accent">Compliance & Security</h3>
          <p class="mt-4 text-sm leading-6 text-white/[0.68]">Enforces continuous biometric access control and data security standards across HIPAA and GDPR-regulated enterprise environments.</p>
        </div>
      </div>
    </section>

    <!-- 4. Solutions Overview (4 Generic Capability Blocks - No Product Names) -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-t border-white/[0.08]">
      <div class="mb-16">
        <span class="inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-mono uppercase tracking-widest text-accent mb-4">
          Solutions Overview
        </span>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Enterprise Capability Suites</h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        <!-- Capability 1 -->
        <div class="clinical-frame rounded-[2rem] p-8 border border-white/[0.08] bg-white/[0.02] flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono uppercase text-accent tracking-wider">Access Management</span>
            <h3 class="text-lg font-semibold text-white mt-1 mb-3">Adaptive Risk-Based Access Control</h3>
            <p class="text-sm leading-6 text-white/[0.72] mb-6">
              Evaluates access requests in real time by analyzing session behavior, device signatures, and network anomaly patterns. It blocks unauthorized intrusion attempts without adding friction to authorized employee workflows. Security leadership gains full visibility into identity risks across multi-tenant cloud environments. This maintains strict compliance standards while securing enterprise systems against credential compromise.
            </p>
          </div>
          <div class="pt-4 border-t border-white/[0.08] text-xs font-mono text-white/[0.5]">
            Delivers sub-50ms access decisions without adding friction to legitimate user sessions.
          </div>
        </div>

        <!-- Capability 2 -->
        <div class="clinical-frame rounded-[2rem] p-8 border border-white/[0.08] bg-white/[0.02] flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono uppercase text-accent tracking-wider">Threat Mitigation</span>
            <h3 class="text-lg font-semibold text-white mt-1 mb-3">Biometric & Graph-Based Fraud Detection</h3>
            <p class="text-sm leading-6 text-white/[0.72] mb-6">
              Maps facial feature vectors against relational transaction graphs to detect sophisticated identity theft networks. The system flags synthetic identity rings and coordinated account takeover attempts before financial or data loss occurs. Fraud prevention teams receive clear structural evidence behind every flagged transaction. This turns complex relational data into immediate risk mitigation.
            </p>
          </div>
          <div class="pt-4 border-t border-white/[0.08] text-xs font-mono text-white/[0.5]">
            Identifies hidden identity syndicates before fraudulent transactions can settle.
          </div>
        </div>

        <!-- Capability 3 -->
        <div class="clinical-frame rounded-[2rem] p-8 border border-white/[0.08] bg-white/[0.02] flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono uppercase text-accent tracking-wider">Radiology Intelligence</span>
            <h3 class="text-lg font-semibold text-white mt-1 mb-3">Automated Medical Imaging Analysis</h3>
            <p class="text-sm leading-6 text-white/[0.72] mb-6">
              Performs automated three-dimensional organ and tumor volume segmentation directly from radiological scan series. It replaces manual contouring, returning precise volumetric measurements to surgical planning tools in seconds. Radiologists accelerate diagnostic throughput while surgical teams plan procedures with millimeter structural confidence. This elevates treatment accuracy across complex clinical cases.
            </p>
          </div>
          <div class="pt-4 border-t border-white/[0.08] text-xs font-mono text-white/[0.5]">
            Converts multi-slice scans into actionable surgical boundaries in seconds.
          </div>
        </div>

        <!-- Capability 4 -->
        <div class="clinical-frame rounded-[2rem] p-8 border border-white/[0.08] bg-white/[0.02] flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono uppercase text-accent tracking-wider">Engineering Productivity</span>
            <h3 class="text-lg font-semibold text-white mt-1 mb-3">Workflow Productivity & Snippet Tooling</h3>
            <p class="text-sm leading-6 text-white/[0.72] mb-6">
              Organizes technical team workflows by maintaining persistent, categorized histories of code snippets, credentials, and data payloads. It prevents accidental data loss during multi-step integrations and complex data entry tasks. Local encryption ensures sensitive technical data never leaves the authorized environment. Engineering teams maintain execution speed without introducing data privacy risks.
            </p>
          </div>
          <div class="pt-4 border-t border-white/[0.08] text-xs font-mono text-white/[0.5]">
            Protects local technical state while accelerating developer context switches.
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Solutions by Department (3 Columns) -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-t border-white/[0.08]">
      <div class="mb-12">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Solutions by Department</h2>
        <p class="mt-2 text-sm text-white/[0.6]">Targeted outcomes aligned directly with institutional leadership accountabilities.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <!-- Healthcare -->
        <div class="clinical-frame rounded-[1.5rem] p-6 border border-white/[0.08] bg-white/[0.02]">
          <h3 class="text-lg font-semibold text-white border-b border-white/[0.1] pb-3 mb-4">Healthcare (Clinical & Operations)</h3>
          <ul class="space-y-3 text-sm text-white/[0.72]">
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Accelerate diagnostic throughput by automating routine image segmentation and risk scoring.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Prevent emergency readmissions through automated longitudinal patient deterioration alerts.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Maintain continuous HIPAA and HITECH compliance across all patient data interfaces.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Optimize bed utilization and staffing allocations using predictive patient flow modeling.</span></li>
          </ul>
        </div>

        <!-- Finance -->
        <div class="clinical-frame rounded-[1.5rem] p-6 border border-white/[0.08] bg-white/[0.02]">
          <h3 class="text-lg font-semibold text-white border-b border-white/[0.1] pb-3 mb-4">Finance (Risk & Fraud Leaders)</h3>
          <ul class="space-y-3 text-sm text-white/[0.72]">
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Stop synthetic identity fraud by validating biometric vectors against relational user graphs.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Reduce false positive security blocks while maintaining strict zero-trust authentication policies.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Uncover hidden fraud syndicates across multi-account transaction networks before settlement.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Streamline regulatory audit trails with immutable access and transaction verification logs.</span></li>
          </ul>
        </div>

        <!-- Enterprise -->
        <div class="clinical-frame rounded-[1.5rem] p-6 border border-white/[0.08] bg-white/[0.02]">
          <h3 class="text-lg font-semibold text-white border-b border-white/[0.1] pb-3 mb-4">Enterprise (CTOs & CISOs)</h3>
          <ul class="space-y-3 text-sm text-white/[0.72]">
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Unify access control and predictive intelligence onto a single performant engine.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Enforce continuous risk-based authentication without degrading user session performance.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Eliminate credential theft vulnerabilities across legacy and modern cloud infrastructures.</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span>Deploy custom AI inference models on-premise or in private cloud environments.</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. How It Works (6 Steps) -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-t border-white/[0.08]">
      <div class="mb-12 text-center">
        <span class="inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-mono uppercase tracking-widest text-accent mb-4">
          Deployment Architecture
        </span>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">How It Works</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
          <p class="text-xs font-mono text-accent uppercase mb-2">Step 1</p>
          <h4 class="text-base font-semibold text-white mb-2">1. Data Ingestion</h4>
          <p class="text-xs leading-5 text-white/[0.68]">Collects structured health records, imaging streams, and access logs across enterprise endpoints.</p>
        </div>

        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
          <p class="text-xs font-mono text-accent uppercase mb-2">Step 2</p>
          <h4 class="text-base font-semibold text-white mb-2">2. Integration & Normalization</h4>
          <p class="text-xs leading-5 text-white/[0.68]">Standardizes, deduplicates, and encrypts incoming streams into unified schema-compliant pipelines.</p>
        </div>

        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
          <p class="text-xs font-mono text-accent uppercase mb-2">Step 3</p>
          <h4 class="text-base font-semibold text-white mb-2">3. AI Processing</h4>
          <p class="text-xs leading-5 text-white/[0.68]">Executes deep learning models for feature extraction, 3D segmentation, and anomaly detection.</p>
        </div>

        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
          <p class="text-xs font-mono text-accent uppercase mb-2">Step 4</p>
          <h4 class="text-base font-semibold text-white mb-2">4. Predictive Analytics</h4>
          <p class="text-xs leading-5 text-white/[0.68]">Evaluates real-time streams against trained clinical and behavioral models to project future risk.</p>
        </div>

        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
          <p class="text-xs font-mono text-accent uppercase mb-2">Step 5</p>
          <h4 class="text-base font-semibold text-white mb-2">5. Actionable Insights</h4>
          <p class="text-xs leading-5 text-white/[0.68]">Surfaces risk alerts and diagnostic boundaries directly within existing operational workflows.</p>
        </div>

        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
          <p class="text-xs font-mono text-accent uppercase mb-2">Step 6</p>
          <h4 class="text-base font-semibold text-white mb-2">6. Continuous Optimization</h4>
          <p class="text-xs leading-5 text-white/[0.68]">Refines model precision automatically through closed-loop feedback and active learning pipelines.</p>
        </div>
      </div>
    </section>

    <!-- 7. Proven Results (3 Stat Cards) -->
    <section class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-t border-white/[0.08]">
      <div class="mb-12 text-center">
        <span class="inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-mono uppercase tracking-widest text-accent mb-4">
          Proven Outcomes
        </span>
