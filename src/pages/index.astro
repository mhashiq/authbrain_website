---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="AuthBrain | AI-Powered Healthcare Intelligence" description="Transform healthcare data into intelligent decisions with AI-powered analytics, predictive insights, and medical imaging intelligence.">
  <Header />
  <main>
    <!-- 1. Hero Section -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <div class="space-y-8">
          <span class="inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-mono uppercase tracking-[0.28em] text-white/[0.72]">
            Smarter Healthcare Through AI
          </span>
          <div class="space-y-5">
            <h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-[-0.05em] text-white sm:text-6xl lg:text-7xl">
              Transform Healthcare Data into Intelligent Decisions.
            </h1>
            <p class="max-w-2xl text-base leading-7 text-white/[0.72] sm:text-lg">
              AI-powered healthcare analytics, predictive insights, medical imaging intelligence, and operational optimization solutions for hospitals, clinics, researchers, and healthcare organizations.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href={`${import.meta.env.BASE_URL}contact/`} class="inline-flex items-center rounded-full bg-accent px-5 py-3 text-sm font-medium text-white transition hover:translate-y-[-1px] hover:bg-accent/90">
              Request a Demo
            </a>
            <a href={`${import.meta.env.BASE_URL}services/`} class="inline-flex items-center rounded-full border border-white/[0.12] bg-white/5 px-5 py-3 text-sm font-medium text-white/[0.80] transition hover:border-white/[0.25] hover:bg-white/[0.08]">
              View Solutions
            </a>
          </div>
        </div>

        <div class="clinical-frame flex items-center justify-center rounded-[2rem] border border-white/[0.1] bg-white/[0.02] p-2 shadow-2xl">
          <img src={`${import.meta.env.BASE_URL}interactive-dashboard.png`} alt="Interactive Dashboard & Imaging Analysis Preview" class="h-full w-full rounded-[1.5rem] object-cover" />
        </div>
      </div>
    </section>

    <!-- 2. Trust & Credibility Section -->
    <section class="border-y border-white/[0.08] bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <p class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-white/[0.5]">Trusted by Hospitals, Research Institutes, and Pharmas</p>
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:gap-12">
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">500M+</p>
            <p class="mt-2 text-sm text-white/[0.6]">Records Processed</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">150+</p>
            <p class="mt-2 text-sm text-white/[0.6]">AI Models Deployed</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">98%</p>
            <p class="mt-2 text-sm text-white/[0.6]">Client Satisfaction</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white sm:text-4xl">25+</p>
            <p class="mt-2 text-sm text-white/[0.6]">Countries Served</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Core Solutions Section -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">AI Healthcare Solutions</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="clinical-frame rounded-[1.75rem] p-8">
          <h3 class="text-xl font-semibold text-white">🏥 Clinical Decision Support</h3>
          <p class="mt-4 text-sm leading-7 text-white/[0.68]">Help physicians make faster and more accurate decisions using AI-driven recommendations.</p>
        </div>
        <div class="clinical-frame rounded-[1.75rem] p-8">
          <h3 class="text-xl font-semibold text-white">📊 Healthcare Data Analytics</h3>
          <p class="mt-4 text-sm leading-7 text-white/[0.68]">Analyze patient, operational, and clinical data through powerful dashboards.</p>
        </div>
        <div class="clinical-frame rounded-[1.75rem] p-8">
          <h3 class="text-xl font-semibold text-white">🧬 Predictive Healthcare</h3>
          <p class="mt-4 text-sm leading-7 text-white/[0.68]">Predict disease risks, patient readmissions, and treatment outcomes.</p>
        </div>
        <div class="clinical-frame rounded-[1.75rem] p-8">
          <h3 class="text-xl font-semibold text-white">🩻 Medical Imaging AI</h3>
          <p class="mt-4 text-sm leading-7 text-white/[0.68]">Advanced analysis for CT, MRI, X-ray, and Ultrasound imaging.</p>
        </div>
        <div class="clinical-frame rounded-[1.75rem] p-8">
          <h3 class="text-xl font-semibold text-white">📈 Population Health Analytics</h3>
          <p class="mt-4 text-sm leading-7 text-white/[0.68]">Monitor healthcare trends and improve community health outcomes.</p>
        </div>
        <div class="clinical-frame rounded-[1.75rem] p-8">
          <h3 class="text-xl font-semibold text-white">🔒 Compliance & Security</h3>
          <p class="mt-4 text-sm leading-7 text-white/[0.68]">HIPAA/GDPR-compliant AI solutions with enterprise-grade security.</p>
        </div>
      </div>
    </section>

    <!-- 4. Why Choose Us -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-10 text-center space-y-4">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">Intelligent Healthcare Transformation</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Advanced AI Algorithms</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Healthcare Industry Expertise</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Real-Time Analytics</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Secure Cloud Infrastructure</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Custom AI Development</span>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5">
          <span class="text-accent">✓</span><span class="font-medium text-white">Regulatory Compliance</span>
        </div>
      </div>
    </section>

    <!-- 5. Industry Use Cases -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Solutions for Every Healthcare Sector</h2>
      </div>
      <div class="grid gap-6 lg:grid-cols-4">
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Hospitals</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Resource optimization</li>
            <li>• Patient flow management</li>
            <li>• Readmission prediction</li>
          </ul>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Diagnostic Centers</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Imaging analysis</li>
            <li>• Reporting automation</li>
            <li>• Quality assurance</li>
          </ul>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Pharmaceuticals</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Clinical trial analytics</li>
            <li>• Drug discovery support</li>
            <li>• Market intelligence</li>
          </ul>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-6">
          <h3 class="text-lg font-semibold text-white">Research Institutions</h3>
          <ul class="mt-4 space-y-2 text-sm text-white/[0.68]">
            <li>• Large-scale data analysis</li>
            <li>• AI research support</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. Data Analytics Platform Showcase -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="clinical-frame rounded-[2rem] p-8 lg:p-12">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div class="space-y-6">
            <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Unified Healthcare Intelligence Platform</h2>
            <div class="grid grid-cols-2 gap-4 text-sm text-white/[0.72]">
              <div class="rounded-lg bg-white/5 p-4">Patient Analytics</div>
              <div class="rounded-lg bg-white/5 p-4">Disease Prediction</div>
              <div class="rounded-lg bg-white/5 p-4">Medical Imaging Results</div>
              <div class="rounded-lg bg-white/5 p-4">Operational KPIs</div>
              <div class="rounded-lg bg-white/5 p-4">Financial Analytics</div>
              <div class="rounded-lg bg-white/5 p-4">Resource Utilization</div>
            </div>
          </div>
          <div class="clinical-frame flex items-center justify-center rounded-[1.5rem] border border-white/[0.1] bg-white/[0.02] p-2 shadow-2xl">
            <img src={`${import.meta.env.BASE_URL}model-perf.png`} alt="Healthcare Analytics Platform Performance" class="w-full h-auto rounded-[1rem] object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Healthcare AI Process -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">How It Works</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6 text-center">
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 1</p><p class="mt-2 text-sm text-white">Collect Healthcare Data</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 2</p><p class="mt-2 text-sm text-white">Clean & Integrate Data</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 3</p><p class="mt-2 text-sm text-white">AI Model Processing</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 4</p><p class="mt-2 text-sm text-white">Predictive Analytics</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 5</p><p class="mt-2 text-sm text-white">Actionable Insights</p></div>
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-4"><p class="metric-label">Step 6</p><p class="mt-2 text-sm text-white">Continuous Optimization</p></div>
      </div>
    </section>

    <!-- 8. Success Stories -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 border-y border-white/[0.08] bg-white/[0.01]">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Real Healthcare Impact</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="clinical-frame rounded-[1.5rem] p-8 text-center">
          <p class="text-4xl font-bold text-accent">32%</p>
          <p class="mt-4 text-sm leading-6 text-white/[0.72]">Reduced patient readmission rates.</p>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-8 text-center">
          <p class="text-4xl font-bold text-accent">28%</p>
          <p class="mt-4 text-sm leading-6 text-white/[0.72]">Improved diagnostic accuracy.</p>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-8 text-center">
          <p class="text-4xl font-bold text-accent">20K+</p>
          <p class="mt-4 text-sm leading-6 text-white/[0.72]">Staff hours saved annually via automation.</p>
        </div>
      </div>
    </section>

    <!-- 8.5 Research & Publications Integration -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="clinical-frame relative overflow-hidden rounded-[2rem] border border-accent/20 bg-accent/5 p-10 lg:p-16">
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent/10 blur-[80px]"></div>
        <div class="relative z-10 flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
          <div class="max-w-xl">
            <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Research & Publications</h2>
            <p class="mt-4 text-base text-white/[0.72]">AuthBrain is a research-driven healthcare AI organization. Our solutions are grounded in rigorous, peer-reviewed academic excellence.</p>
            <a href={`${import.meta.env.BASE_URL}research/`} class="mt-8 inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-medium text-black transition hover:bg-white/90">
              View All Publications & Books
            </a>
          </div>
          <div class="grid grid-cols-3 gap-6 sm:gap-10 text-center">
            <div><p class="text-4xl font-bold text-white">5</p><p class="mt-2 text-xs uppercase tracking-widest text-white/[0.5]">Books</p></div>
            <div><p class="text-4xl font-bold text-white">100+</p><p class="mt-2 text-xs uppercase tracking-widest text-white/[0.5]">Publications</p></div>
            <div><p class="text-4xl font-bold text-white">2100+</p><p class="mt-2 text-xs uppercase tracking-widest text-white/[0.5]">Citations</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Technologies We Use -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-10">
        <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white">Technologies We Use</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        <div>
          <p class="metric-label border-b border-white/[0.1] pb-2 mb-4">Artificial Intelligence</p>
          <ul class="space-y-2 text-sm text-white/[0.72]">
            <li>Machine Learning</li>
            <li>Deep Learning</li>
            <li>NLP</li>
            <li>Computer Vision</li>
          </ul>
        </div>
        <div>
          <p class="metric-label border-b border-white/[0.1] pb-2 mb-4">Healthcare Standards</p>
          <ul class="space-y-2 text-sm text-white/[0.72]">
            <li>HL7</li>
            <li>FHIR</li>
            <li>DICOM</li>
            <li>nii.gz*</li>
          </ul>
        </div>
        <div>
          <p class="metric-label border-b border-white/[0.1] pb-2 mb-4">Cloud Platforms</p>
          <ul class="space-y-2 text-sm text-white/[0.72]">
            <li>AWS</li>
            <li>Azure</li>
            <li>Google Cloud</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 10. Testimonials -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="clinical-frame rounded-[1.5rem] p-8 relative">
          <span class="absolute top-4 left-4 text-6xl text-white/[0.05]">"</span>
          <p class="relative z-10 text-lg italic text-white/[0.85]">"Their AI platform transformed our patient analytics capabilities."</p>
          <p class="mt-6 text-sm font-semibold text-accent">— Chief Medical Officer</p>
        </div>
        <div class="clinical-frame rounded-[1.5rem] p-8 relative">
          <span class="absolute top-4 left-4 text-6xl text-white/[0.05]">"</span>
          <p class="relative z-10 text-lg italic text-white/[0.85]">"Outstanding healthcare data insights and predictive capabilities."</p>
          <p class="mt-6 text-sm font-semibold text-accent">— Hospital Administrator</p>
        </div>
      </div>
    </section>

    <!-- 11. Call-To-Action Section -->
    <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8 text-center">
      <div class="clinical-frame rounded-[2rem] p-10 lg:p-16">
        <h2 class="text-4xl font-semibold tracking-tight text-white mb-6">Ready to Modernize Healthcare with AI?</h2>
        <p class="text-lg text-white/[0.72] mb-10 max-w-2xl mx-auto">Empower your organization with intelligent healthcare analytics and AI-driven decision-making.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={`${import.meta.env.BASE_URL}contact/`} class="inline-flex items-center justify-center rounded-full bg-accent px-8 py-4 text-sm font-medium text-white transition hover:bg-accent/90">
            Schedule Consultation
          </a>
          <a href={`${import.meta.env.BASE_URL}contact/`} class="inline-flex items-center justify-center rounded-full border border-white/[0.12] bg-white/5 px-8 py-4 text-sm font-medium text-white/[0.80] transition hover:bg-white/[0.1]">
            Request Demo
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- 12. Footer -->
  <footer class="border-t border-white/[0.08] bg-white/[0.02]">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 grid-cols-2 md:grid-cols-4">
        <div>
          <p class="font-semibold text-white mb-4">Company</p>
          <ul class="space-y-3 text-sm text-white/[0.6]">
            <li><a href="#" class="hover:text-white transition">About Us</a></li>
            <li><a href="#" class="hover:text-white transition">Leadership</a></li>
            <li><a href="#" class="hover:text-white transition">Careers</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-white mb-4">Solutions</p>
          <ul class="space-y-3 text-sm text-white/[0.6]">
            <li><a href={`${import.meta.env.BASE_URL}services/`} class="hover:text-white transition">Healthcare Analytics</a></li>
            <li><a href={`${import.meta.env.BASE_URL}services/`} class="hover:text-white transition">Medical Imaging AI</a></li>
            <li><a href={`${import.meta.env.BASE_URL}services/`} class="hover:text-white transition">Predictive Intelligence</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-white mb-4">Resources</p>
          <ul class="space-y-3 text-sm text-white/[0.6]">
            <li><a href="#" class="hover:text-white transition">Blog</a></li>
            <li><a href="#" class="hover:text-white transition">Whitepapers</a></li>
            <li><a href="#" class="hover:text-white transition">Case Studies</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-white mb-4">Contact</p>
          <ul class="space-y-3 text-sm text-white/[0.6]">
            <li><a href="mailto:authbrain.tech@gmail.com" class="hover:text-white transition">Email</a></li>
            <li><a href="#" class="hover:text-white transition">Phone</a></li>
            <li><a href="#" class="hover:text-white transition">LinkedIn</a></li>
          </ul>
        </div>
      </div>
      <div class="mt-12 border-t border-white/[0.08] pt-8 text-sm text-white/[0.52] flex flex-col sm:flex-row justify-between items-center gap-4">
        <p>© 2026 AuthBrain. AI-Powered Healthcare Intelligence.</p>
        <p class="font-mono uppercase tracking-[0.2em] text-[10px]">Empowering Data-Driven Healthcare</p>
      </div>
    </div>
  </footer>
</BaseLayout>