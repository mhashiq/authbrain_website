<script is:inline>
  const setupMarquee = () => {
    const container = document.getElementById('marquee-container');
    const track = document.getElementById('marquee-track');
    const btn = document.getElementById('toggle-marquee-btn');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const btnText = document.getElementById('marquee-btn-text');

    if (!container || !track || !btn || btn.dataset.setup) return;
    btn.dataset.setup = "true";

    let isPlaying = false;
    let pos = 0;
    let speed = 1; // Auto-scroll speed
    let animationId;
    let isDragging = false;
    let startX = 0;

    // JS-driven animation loop
    const updateLoop = () => {
      if (!track.isConnected) return; // Clean up memory if component unmounts
      let trackWidth = track.scrollWidth / 2;
      
      if (isPlaying && !isDragging) {
        pos -= speed;
      }
      
      // Infinite Loop Wrap-around logic
      if (pos <= -trackWidth) pos += trackWidth;
      if (pos > 0) pos -= trackWidth;
      
      track.style.transform = `translateX(${pos}px)`;
      animationId = requestAnimationFrame(updateLoop);
    };
    
    updateLoop(); // Start loop

    btn.addEventListener('click', () => {
      isPlaying = !isPlaying;
      playIcon.classList.toggle('hidden', isPlaying);
      pauseIcon.classList.toggle('hidden', !isPlaying);
      btnText.textContent = isPlaying ? 'Pause Live Feedback' : 'Run Live Feedback';
    });

    // Mouse Dragging
    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.pageX;
    });
    container.addEventListener('mouseup', () => { isDragging = false; });
    container.addEventListener('mouseleave', () => { isDragging = false; });
    container.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault(); // Prevent text highlighting while dragging
      pos += (e.pageX - startX);
      startX = e.pageX;
    });

    // Touch Swiping for Mobile
    container.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].pageX;
    }, { passive: true });
    container.addEventListener('touchend', () => { isDragging = false; });
    container.addEventListener('touchcancel', () => { isDragging = false; });
    container.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      pos += (e.touches[0].pageX - startX);
      startX = e.touches[0].pageX;
    }, { passive: true });
  };

  setupMarquee();
  document.addEventListener('astro:page-load', setupMarquee);
</script>