---
---

<section id="top" class="relative overflow-hidden pt-12 pb-16 bg-white border-b border-[#E5E3E0]">
  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-[#FDF2F0] border border-[#F8D5CE] px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-[#E64A25]">
        Predictive Intelligence for Regulated Domains
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-[#0D0D0D] sm:text-5xl lg:text-6xl">
        Clinical-grade AI systems for imaging, risk, and decision support.
      </h1>

      <p class="text-base text-[#3A3A3A] sm:text-lg leading-relaxed">
        AuthBrain designs research-focused models and product surfaces that convert complex medical signals into fast, defensible workflows.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href={`${import.meta.env.BASE_URL}research/`}
          class="inline-flex items-center rounded-xl bg-[#E64A25] px-5 py-3 text-sm font-semibold text-white shadow-xs hover:bg-[#C93E1D] transition"
        >
          Explore Publications
        </a>
      </div>
    </div>

    <div class="rounded-2xl border border-[#E5E3E0] bg-[#F4F3F1] p-6 shadow-xs">
      <div class="flex items-center justify-between border-b border-[#E5E3E0] pb-3 mb-4">
        <span class="text-xs font-semibold uppercase text-[#E64A25]">Imaging Signal Telemetry</span>
        <span class="rounded bg-emerald-100 text-emerald-800 px-2 py-0.5 text-xs font-mono font-medium">LIVE</span>
      </div>
      <div class="space-y-3 font-mono text-xs">
        <div class="p-3 bg-white rounded-lg border border-[#E5E3E0]">
          <div class="flex justify-between text-gray-500 mb-1">
            <span>SEQUENCE // 04</span>
            <span class="text-[#E64A25] font-semibold">&lt; 120ms</span>
          </div>
          <p class="font-sans text-sm font-bold text-[#0D0D0D]">Pattern Recognition: 99.2% Alignment</p>
        </div>
      </div>
    </div>
  </div>
</section>