---

<section id="top" class="relative overflow-hidden pt-12 pb-16 bg-white border-b border-gray-200">
  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-700">
        Predictive Intelligence for Regulated Domains
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
        Clinical-grade AI systems for imaging, risk, and decision support.
      </h1>

      <p class="text-base text-gray-600 sm:text-lg leading-relaxed">
        AuthBrain designs research-focused models and product surfaces that convert complex medical signals into fast, defensible workflows.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href={`${import.meta.env.BASE_URL}research/`}
          class="inline-flex items-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-xs hover:bg-blue-700"
        >
          Explore Publications
        </a>
      </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-gray-50/70 p-6 shadow-xs">
      <div class="flex items-center justify-between border-b border-gray-200 pb-3 mb-4">
        <span class="text-xs font-semibold uppercase text-blue-600">Imaging Signal Telemetry</span>
        <span class="rounded bg-emerald-100 text-emerald-700 px-2 py-0.5 text-xs font-mono font-medium">LIVE</span>
      </div>
      <div class="space-y-3 font-mono text-xs">
        <div class="p-3 bg-white rounded-lg border border-gray-200">
          <div class="flex justify-between text-gray-500 mb-1">
            <span>SEQUENCE // 04</span>
            <span class="text-blue-600 font-semibold">&lt; 120ms</span>
          </div>
          <p class="font-sans text-sm font-bold text-gray-900">Pattern Recognition: 99.2% Alignment</p>
        </div>
      </div>
    </div>
  </div>
</section>