---
---

<section id="top" class="relative overflow-hidden">
  <div class="absolute inset-0 clinical-grid opacity-30"></div>
  <div class="absolute left-1/2 top-0 h-80 w-80 -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-24">
    <div class="space-y-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-mono uppercase tracking-[0.28em] text-white/[0.70]">
        Predictive intelligence for regulated domains
      </div>

      <div class="space-y-6">
        <h1 class="max-w-3xl text-5xl font-semibold leading-none tracking-[-0.05em] text-white sm:text-6xl lg:text-7xl">
          Clinical-grade AI systems for imaging, risk, and decision support.
        </h1>
        <p class="max-w-2xl text-base leading-7 text-white/[0.72] sm:text-lg">
          AuthBrain designs research-focused models and product surfaces that convert complex medical signals into fast, defensible workflows.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="#publications"
          class="inline-flex items-center rounded-full bg-accent px-5 py-3 text-sm font-medium text-white transition hover:translate-y-[-1px] hover:bg-accent/90"
        >
          Explore publications
        </a>
        <a
          href="#research"
          class="inline-flex items-center rounded-full border border-white/[0.12] bg-white/5 px-5 py-3 text-sm font-medium text-white/[0.80] transition hover:border-white/[0.25] hover:bg-white/[0.08]"
        >
          View research hub
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="clinical-frame relative overflow-hidden rounded-[2rem] p-6 sm:p-8">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_48%)]"></div>
        <div class="relative space-y-5">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="metric-label">Imaging signal</p>
              <p class="mt-2 font-mono text-sm text-white/[0.85]">Latent pattern alignment</p>
            </div>
            <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-[0.7rem] uppercase tracking-[0.28em] text-accent">
              Live scan
            </span>
          </div>

          <div class="clinical-frame relative aspect-[4/3] overflow-hidden rounded-[1.5rem] bg-[#070707]">
            <div class="absolute inset-0 opacity-45 clinical-grid"></div>
            <div class="absolute inset-6 rounded-[1.25rem] border border-white/[0.08]"></div>
            <div class="absolute left-1/2 top-1/2 h-44 w-44 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/[0.20]"></div>
            <div class="scan-ring animate-pulseSoft"></div>
            <div class="scan-ring" style="transform: scale(0.72);"></div>
            <div class="scan-ring" style="transform: scale(0.48); border-color: rgba(255, 90, 42, 0.26);"></div>
            <div class="absolute inset-x-0 top-1/2 h-px bg-gradient-to-r from-transparent via-accent/80 to-transparent animate-scan"></div>
            <div class="absolute left-8 top-8 space-y-2 text-xs font-mono uppercase tracking-[0.28em] text-white/[0.55]">
              <p>Sequence 04</p>
              <p>Confidence 0.98</p>
            </div>
            <div class="absolute bottom-8 right-8 text-right text-xs font-mono uppercase tracking-[0.28em] text-white/[0.55]">
              <p>Pattern recognition</p>
              <p>Attention routing</p>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-white/[0.08] bg-white/[0.04] p-4">
              <p class="metric-label">Inference</p>
              <p class="mt-3 metric-value">&lt; 120 ms</p>
            </div>
            <div class="rounded-2xl border border-white/[0.08] bg-white/[0.04] p-4">
              <p class="metric-label">Focus</p>
              <p class="mt-3 metric-value">Imaging + risk</p>
            </div>
            <div class="rounded-2xl border border-white/[0.08] bg-white/[0.04] p-4">
              <p class="metric-label">Mode</p>
              <p class="mt-3 metric-value">Research first</p>
            </div>
          </div>

          <div class="rounded-2xl border border-white/[0.08] bg-white/[0.04] p-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="metric-label">Thinking pulse</p>
                <p class="mt-2 text-sm text-white/[0.75]">A subtle homepage micro-interaction that suggests model reasoning without visual clutter.</p>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-accent/90 animate-pulseSoft"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/[0.45] animate-pulseSoft [animation-delay:160ms]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/[0.25] animate-pulseSoft [animation-delay:320ms]"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>