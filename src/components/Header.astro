---
const navItems = [
  { label: 'Home', href: import.meta.env.BASE_URL },
  { label: 'Services', href: `${import.meta.env.BASE_URL}services/` },
  { label: 'Publications & Books', href: `${import.meta.env.BASE_URL}research/` },
  { label: 'Python Stack', href: `${import.meta.env.BASE_URL}python-stack/` },
  { label: 'Agent Lab', href: `${import.meta.env.BASE_URL}agent-lab/` },
  { label: 'Contact', href: `${import.meta.env.BASE_URL}contact/` },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/[0.08] bg-ink/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3">
      <img
        src={`${import.meta.env.BASE_URL}company-logo.jpeg`}
        alt="AuthBrain logo"
        class="h-12 w-auto sm:h-14"
      />
      <span class="hidden text-xs font-mono uppercase tracking-[0.32em] text-white/[0.60] sm:inline">
        Python AI Services
      </span>
    </a>

    <nav class="flex flex-wrap items-center justify-end gap-4 text-sm text-white/[0.70] sm:gap-5">
      {navItems.map((item) => (
        <a
          aria-current={currentPath === item.href ? 'page' : undefined}
          class:list={[
            'transition hover:text-white',
            currentPath === item.href && 'text-white',
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>