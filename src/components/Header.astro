---
const navItems = [
  { label: 'Home', href: import.meta.env.BASE_URL },
  { label: 'Services', href: `${import.meta.env.BASE_URL}services/` },
  { label: 'Products', href: `${import.meta.env.BASE_URL}products/` },
  { label: 'About', href: `${import.meta.env.BASE_URL}about/` },
  { label: 'Publications & Books', href: `${import.meta.env.BASE_URL}research/` },
  { label: 'Contact', href: `${import.meta.env.BASE_URL}contact/` },
];

const currentPath = Astro.url.pathname;
---

<header id="main-header" class="sticky top-0 z-50 border-b border-gray-200/80 bg-white/90 backdrop-blur-md transition-shadow duration-200">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8 relative z-50">
    <!-- Previous Brand Logo (Restored) -->
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 group focus:outline-none">
      <div class="relative flex h-10 w-10 items-center justify-center">
        <span class="absolute text-2xl auth-brain-anim">🧠</span>
        <span class="absolute text-xl -ml-8 mt-4 auth-key-anim origin-bottom-right drop-shadow-md">🔑</span>
        <span class="absolute text-2xl -mt-10 auth-idea-anim opacity-0 drop-shadow-[0_0_12px_rgba(250,204,21,0.8)]">💡</span>
      </div>
      <div class="text-left transition-opacity group-hover:opacity-80">
        <p class="font-bold text-gray-900 tracking-wide text-base leading-tight">AuthBrain</p>
        <p class="text-[10px] uppercase tracking-[0.2em] text-blue-600 font-semibold leading-tight mt-0.5">Unlocking Ideas</p>
      </div>
    </a>

    <!-- Desktop Navigation Items -->
    <nav class="hidden lg:flex items-center gap-7 text-sm font-medium text-gray-600">
      {navItems.map((item) => (
        <a
          aria-current={currentPath === item.href ? 'page' : undefined}
          class:list={[
            'transition-colors hover:text-blue-600 py-1 relative',
            currentPath === item.href ? 'text-blue-600 font-semibold' : 'text-gray-600',
          ]}
          href={item.href}
        >
          {item.label}
          {currentPath === item.href && (
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-blue-600 rounded-full"></span>
          )}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA Button -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={`${import.meta.env.BASE_URL}contact/`}
        class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition-all hover:bg-blue-700 hover:shadow focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      >
        Schedule Technical Demo
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button 
      id="mobile-menu-btn" 
      class="flex lg:hidden relative h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-gray-700 hover:bg-gray-100 focus:outline-none"
      aria-label="Toggle Navigation Menu"
    >
      <svg id="menu-icon" class="h-5 w-5 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="h-5 w-5 hidden transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden border-b border-gray-200 bg-white/95 backdrop-blur-xl px-4 py-5 shadow-lg"
  >
    <nav class="flex flex-col space-y-3">
      {navItems.map((item) => (
        <a
          aria-current={currentPath === item.href ? 'page' : undefined}
          class:list={[
            'flex items-center justify-between rounded-lg px-3 py-2 text-base font-medium transition-colors',
            currentPath === item.href ? 'bg-blue-50 text-blue-600' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900',
          ]}
          href={item.href}
        >
          <span>{item.label}</span>
          <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
      <div class="pt-3 border-t border-gray-100">
        <a
          href={`${import.meta.env.BASE_URL}contact/`}
          class="flex w-full items-center justify-center rounded-lg bg-blue-600 py-3 text-center text-base font-medium text-white shadow-sm hover:bg-blue-700"
        >
          Schedule Technical Demo
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const setupHeader = () => {
    const header = document.getElementById('main-header');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    // Sticky shadow listener
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        header?.classList.add('shadow-sm', 'border-gray-200');
      } else {
        header?.classList.remove('shadow-sm');
      }
    });

    if (!btn || !menu || btn.dataset.menuSetup) return;
    btn.dataset.menuSetup = "true";

    let isMenuOpen = false;

    btn.addEventListener('click', () => {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        menu.classList.remove('hidden');
        menuIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        menuIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });
  };

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .auth-brain-anim { animation: brainPulse 4s infinite ease-in-out; }
  .auth-key-anim { animation: keyUnlock 4s infinite ease-in-out; }
  .auth-idea-anim { animation: ideaPop 4s infinite ease-in-out; }

  @keyframes brainPulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    30%, 80% { transform: scale(1.1); opacity: 1; }
  }
  @keyframes keyUnlock {
    0%, 100% { transform: translate(-15px, 15px) rotate(-45deg); opacity: 0; }
    15% { transform: translate(-4px, 4px) rotate(0deg); opacity: 1; }
    25% { transform: translate(-4px, 4px) rotate(90deg); opacity: 1; }
    35%, 90% { transform: translate(15px, 15px) rotate(90deg); opacity: 0; }
  }
  @keyframes ideaPop {
    0%, 25% { opacity: 0; transform: translateY(10px) scale(0.5); }
    35%, 75% { opacity: 1; transform: translateY(-5px) scale(1.1); }
    85%, 100% { opacity: 0; transform: translateY(-15px) scale(1); }
  }
</style>