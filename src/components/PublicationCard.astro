---
interface Props {
  title: string;
  summary: string;
  journal: string;
  date: string;
  clinicalImpact: string;
  tags: string[];
}

const { title, summary, journal, date, clinicalImpact, tags } = Astro.props satisfies Props;
---

<article class="clinical-frame group rounded-[1.75rem] p-6 transition hover:-translate-y-1 hover:border-white/[0.18]">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-3">
      <p class="metric-label">{journal}</p>
      <h3 class="text-2xl font-semibold tracking-[-0.04em] text-white">{title}</h3>
    </div>
    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.26em] text-white/[0.55]">
      {date}
    </span>
  </div>

  <p class="mt-4 text-sm leading-7 text-white/[0.68]">{summary}</p>

  <div class="mt-5 rounded-2xl border border-accent/[0.18] bg-accent/[0.08] p-4">
    <p class="metric-label">Clinical impact</p>
    <p class="mt-2 text-sm leading-6 text-white/[0.82]">{clinicalImpact}</p>
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-white/[0.72]">
        {tag}
      </span>
    ))}
  </div>
</article>