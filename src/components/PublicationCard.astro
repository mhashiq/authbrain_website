---
interface Props {
  title: string;
  summary: string;
  journal: string;
  date: string;
  clinicalImpact: string;
  tags: string[];
}

const { title, summary, journal, date, clinicalImpact, tags } = Astro.props satisfies Props;
---

<article class="rounded-2xl border border-gray-200 bg-white p-7 shadow-xs transition-all hover:shadow-md hover:border-blue-200">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">{journal}</p>
      <h3 class="text-xl font-bold text-gray-900">{title}</h3>
    </div>
    <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1 font-mono text-xs font-medium text-gray-600 border border-gray-200">
      {date}
    </span>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-gray-600">{summary}</p>

  <div class="mt-5 rounded-xl border border-blue-100 bg-blue-50/60 p-4">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-blue-700">Clinical & Operational Impact</p>
    <p class="mt-1 text-xs text-gray-800 font-medium leading-relaxed">{clinicalImpact}</p>
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full bg-gray-50 border border-gray-200 px-3 py-1 text-xs font-medium text-gray-600">
        {tag}
      </span>
    ))}
  </div>
</article>