---
interface Props {
  title: string;
  summary: string;
  journal: string;
  date: string;
  clinicalImpact: string;
  tags: string[];
}

const { title, summary, journal, date, clinicalImpact, tags } = Astro.props satisfies Props;
---

<article class="rounded-2xl border border-[#E5E3E0] bg-white p-7 shadow-xs transition-all hover:shadow-md hover:border-[#F8D5CE]">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#E64A25]">{journal}</p>
      <h3 class="text-xl font-bold text-[#0D0D0D]">{title}</h3>
    </div>
    <span class="shrink-0 rounded-full bg-[#F4F3F1] px-3 py-1 font-mono text-xs font-medium text-[#3A3A3A] border border-[#E5E3E0]">
      {date}
    </span>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-[#3A3A3A]">{summary}</p>

  <div class="mt-5 rounded-xl border border-[#F8D5CE] bg-[#FDF2F0]/80 p-4">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[#E64A25]">Clinical & Operational Impact</p>
    <p class="mt-1 text-xs text-[#0D0D0D] font-medium leading-relaxed">{clinicalImpact}</p>
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full bg-[#F4F3F1] border border-[#E5E3E0] px-3 py-1 text-xs font-medium text-[#3A3A3A]">
        {tag}
      </span>
    ))}
  </div>
</article>