---
interface Props {
  title: string;
  summary: string;
  status: 'sandbox' | 'coming-soon';
  focus: string;
  ctaLabel: string;
  href?: string;
}

const { title, summary, status, focus, ctaLabel, href } = Astro.props satisfies Props;
---

<article class="clinical-frame rounded-[1.75rem] p-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="metric-label">Future product</p>
      <h3 class="mt-3 text-2xl font-semibold tracking-[-0.04em] text-white">{title}</h3>
    </div>
    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.26em] text-white/[0.55]">
      {status.replace('-', ' ')}
    </span>
  </div>

  <p class="mt-4 text-sm leading-7 text-white/[0.68]">{summary}</p>

  <div class="mt-5 rounded-2xl border border-white/[0.08] bg-white/[0.04] p-4">
    <p class="metric-label">Focus</p>
    <p class="mt-2 text-sm text-white/[0.82]">{focus}</p>
  </div>

  <div class="mt-6">
    {href ? (
      <a
        href={href}
        class="inline-flex items-center rounded-full bg-accent px-5 py-3 text-sm font-medium text-white transition hover:bg-accent/90"
      >
        {ctaLabel}
      </a>
    ) : (
      <button
        type="button"
        class="inline-flex cursor-not-allowed items-center rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-medium text-white/[0.55]"
      >
        {ctaLabel}
      </button>
    )}
  </div>
</article>