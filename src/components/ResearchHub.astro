---
interface Props {
  scholarUrl: string;
}

const { scholarUrl } = Astro.props satisfies Props;
---

<section id="research" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-xs">
      <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Research Hub</p>
      <h2 class="mt-3 text-2xl font-bold text-gray-900 sm:text-3xl">
        Publications, citations, and model notes in one clinical view.
      </h2>
      <p class="mt-4 text-sm text-gray-600 leading-relaxed">
        Keep AuthBrain positioned as a research-driven firm by connecting the site directly to your Scholar profile and publication stream.
      </p>
      <a
        href={scholarUrl}
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-flex items-center rounded-xl border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-700 shadow-xs transition hover:bg-gray-50 hover:border-blue-300 hover:text-blue-600"
      >
        Open Google Scholar Profile
        <svg class="ml-2 h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-xs">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Output Cadence</p>
        <p class="mt-2 text-3xl font-extrabold text-blue-600">12+</p>
        <p class="mt-2 text-xs text-gray-600 leading-relaxed">Research notes, technical briefs, and publication summaries ready for a content-first funnel.</p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-xs">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Signal Quality</p>
        <p class="mt-2 text-3xl font-extrabold text-blue-600">A+</p>
        <p class="mt-2 text-xs text-gray-600 leading-relaxed">Evidence-led storytelling for regulated buyers who want clarity before demos.</p>
      </div>
      <div class="rounded-2xl border border-blue-100 bg-blue-50/50 p-5 sm:col-span-2">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-blue-700">Research Callout</p>
        <p class="mt-2 font-mono text-xs leading-relaxed text-gray-800">
          “Low-latency inference with clinical overlays improves stakeholder confidence by turning model output into a visible, auditable signal.”
        </p>
      </div>
    </div>
  </div>
</section>