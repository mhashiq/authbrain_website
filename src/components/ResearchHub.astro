---
interface Props {
  scholarUrl: string;
}

const { scholarUrl } = Astro.props satisfies Props;
---

<section id="research" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="clinical-frame rounded-[2rem] p-6 sm:p-8">
      <p class="metric-label">Research hub</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">
        Publications, citations, and model notes in one clinical view.
      </h2>
      <p class="mt-4 max-w-xl text-white/[0.70]">
        Keep AuthBrain positioned as a research-driven firm by connecting the site directly to your Scholar profile and publication stream.
      </p>
      <a
        href={scholarUrl}
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-flex items-center rounded-full border border-white/[0.12] bg-white/5 px-5 py-3 text-sm font-medium text-white/[0.80] transition hover:border-accent/[0.35] hover:bg-accent/10 hover:text-white"
      >
        Open Google Scholar profile
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="clinical-frame rounded-[1.5rem] p-5">
        <p class="metric-label">Output cadence</p>
        <p class="mt-3 text-4xl font-semibold tracking-[-0.05em] text-white">12+</p>
        <p class="mt-3 text-sm text-white/[0.65]">Research notes, technical briefs, and publication summaries ready for a content-first funnel.</p>
      </div>
      <div class="clinical-frame rounded-[1.5rem] p-5">
        <p class="metric-label">Signal quality</p>
        <p class="mt-3 text-4xl font-semibold tracking-[-0.05em] text-white">A+</p>
        <p class="mt-3 text-sm text-white/[0.65]">Evidence-led storytelling for regulated buyers who want clarity before demos.</p>
      </div>
      <div class="clinical-frame rounded-[1.5rem] p-5 sm:col-span-2">
        <p class="metric-label">Research snippet</p>
        <p class="mt-3 font-mono text-sm leading-7 text-white/[0.76]">
          “Low-latency inference with clinical overlays improves stakeholder confidence by turning model output into a visible, auditable signal.”
        </p>
      </div>
    </div>
  </div>
</section>