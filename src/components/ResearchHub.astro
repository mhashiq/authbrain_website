---
interface Props {
  scholarUrl: string;
}

const { scholarUrl } = Astro.props satisfies Props;
---

<section id="research" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="rounded-2xl border border-[#E5E3E0] bg-white p-6 sm:p-8 shadow-xs">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#E64A25]">Research Hub</p>
      <h2 class="mt-3 text-2xl font-bold text-[#0D0D0D] sm:text-3xl">
        Publications, citations, and model notes in one clinical view.
      </h2>
      <p class="mt-4 text-sm text-[#3A3A3A] leading-relaxed">
        Keep AuthBrain positioned as a research-driven firm by connecting the site directly to your Scholar profile and publication stream.
      </p>
      <a
        href={scholarUrl}
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-flex items-center rounded-xl border border-[#E5E3E0] bg-white px-5 py-3 text-sm font-semibold text-[#0D0D0D] shadow-xs transition hover:bg-[#F4F3F1] hover:border-[#F8D5CE] hover:text-[#E64A25]"
      >
        Open Google Scholar Profile
        <svg class="ml-2 h-4 w-4 text-[#E64A25]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-[#E5E3E0] bg-white p-5 shadow-xs">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Output Cadence</p>
        <p class="mt-2 text-3xl font-extrabold text-[#E64A25]">12+</p>
        <p class="mt-2 text-xs text-[#3A3A3A] leading-relaxed">Research notes, technical briefs, and publication summaries ready for a content-first funnel.</p>
      </div>
      <div class="rounded-2xl border border-[#E5E3E0] bg-white p-5 shadow-xs">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Signal Quality</p>
        <p class="mt-2 text-3xl font-extrabold text-[#E64A25]">A+</p>
        <p class="mt-2 text-xs text-[#3A3A3A] leading-relaxed">Evidence-led storytelling for regulated buyers who want clarity before demos.</p>
      </div>
      <div class="rounded-2xl border border-[#F8D5CE] bg-[#FDF2F0]/80 p-5 sm:col-span-2">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[#E64A25]">Research Callout</p>
        <p class="mt-2 font-mono text-xs leading-relaxed text-[#0D0D0D]">
          “Low-latency inference with clinical overlays improves stakeholder confidence by turning model output into a visible, auditable signal.”
        </p>
      </div>
    </div>
  </div>
</section>